<relation connection='sqlserver.9ed47817a61c857003784ebf7af3' name='Custom SQL Query' type='text'>SELECT business_date, tenant_id, tenant_name, plan_tier, region_code, api_units, compute_units, storage_peak_mb, bytes_used, active_users, document_count, file_count FROM mart.mart_tenant_usage_daily WHERE business_date = &lt;[Parameters].[Business Date]&gt; ORDER BY tenant_name</relation>
