<relation connection='sqlserver.36645d6c02b5ff96b124a449d009' name='Custom SQL Query' type='text'>SELECT business_date, tenant_id, tenant_name, plan_tier, storage_peak_mb, bytes_used FROM mart.mart_tenant_usage_daily WHERE business_date = &lt;[Parameters].[Business Date]&gt; ORDER BY storage_peak_mb DESC</relation>
