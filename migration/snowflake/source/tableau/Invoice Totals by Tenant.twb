<datasource caption="Invoice Totals" inline='true' name='federated.88ee7ab23d96dbd253b5d9fe158a' version='18.1'>
<connection class='federated'>
<named-connections>
<named-connection caption='127.0.0.1' name='sqlserver.f861d9eadbbd09e57fb2087ee731'>
<connection authentication='sqlserver' class='sqlserver' dbname='OtterWorksUBW' odbc-native-protocol='' one-time-sql='' port='14333' server='127.0.0.1' username='sa' />
</named-connection>
</named-connections>
<relation connection='sqlserver.f861d9eadbbd09e57fb2087ee731' name='Custom SQL Query' type='text'>SELECT business_date, tenant_id, SUM(amount_cents) AS amount_cents, COUNT(DISTINCT invoice_id) AS invoice_count FROM fact.fact_invoice_lines WHERE business_date = &lt;[Parameters].[Business Date]&gt; GROUP BY business_date, tenant_id ORDER BY amount_cents DESC</relation>
</connection>
<aliases enabled='yes' />
<column datatype='date' name='[business_date]' role='dimension' type='ordinal' />
<column datatype='string' name='[tenant_id]' role='dimension' type='nominal' />
<column datatype='integer' name='[amount_cents]' role='measure' type='quantitative' />
<column datatype='integer' name='[invoice_count]' role='measure' type='quantitative' />
</datasource>
