<datasource caption="Region Usage" inline='true' name='federated.982d2f6b18970e02b20be7ad8eb9' version='18.1'>
<connection class='federated'>
<named-connections>
<named-connection caption='127.0.0.1' name='sqlserver.95a8fb969f092621a8863a819aac'>
<connection authentication='sqlserver' class='sqlserver' dbname='OtterWorksUBW' odbc-native-protocol='' one-time-sql='' port='14333' server='127.0.0.1' username='sa' />
</named-connection>
</named-connections>
<relation connection='sqlserver.95a8fb969f092621a8863a819aac' name='Custom SQL Query' type='text'>SELECT business_date, region_code, COUNT_BIG(*) AS tenant_count, SUM(api_units) AS api_units, SUM(compute_units) AS compute_units, SUM(bytes_used) AS bytes_used FROM mart.mart_tenant_usage_daily WHERE business_date = &lt;[Parameters].[Business Date]&gt; GROUP BY business_date, region_code ORDER BY region_code</relation>
</connection>
<aliases enabled='yes' />
<column datatype='date' name='[business_date]' role='dimension' type='ordinal' />
<column datatype='string' name='[region_code]' role='dimension' type='nominal' />
<column datatype='integer' name='[tenant_count]' role='measure' type='quantitative' />
<column datatype='integer' name='[api_units]' role='measure' type='quantitative' />
<column datatype='integer' name='[compute_units]' role='measure' type='quantitative' />
<column datatype='integer' name='[bytes_used]' role='measure' type='quantitative' />
</datasource>
</datasources>
