</named-connections>
<relation connection='sqlserver.e4eb98d0e24dd961baf7ef8fbf49' name='Custom SQL Query' type='text'>SELECT business_date, tenant_id, plan_id, plan_tier, seat_count, seat_limit, over_limit FROM fact.fact_seat_assignments WHERE business_date = &lt;[Parameters].[Business Date]&gt; AND over_limit = 1 ORDER BY plan_tier, tenant_id</relation>
</connection>
<aliases enabled='yes' />
<column datatype='date' name='[business_date]' role='dimension' type='ordinal' />
