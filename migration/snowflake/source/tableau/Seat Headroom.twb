<datasource caption="Seat Headroom" inline='true' name='federated.bdcf43a91f6d24836c9c25bddeb3' version='18.1'>
<connection class='federated'>
<named-connections>
<named-connection caption='127.0.0.1' name='sqlserver.2a0b85ccc1907fb68104b27f61dc'>
<connection authentication='sqlserver' class='sqlserver' dbname='OtterWorksUBW' odbc-native-protocol='' one-time-sql='' port='14333' server='127.0.0.1' username='sa' />
</named-connection>
</named-connections>
<relation connection='sqlserver.2a0b85ccc1907fb68104b27f61dc' name='Custom SQL Query' type='text'>SELECT business_date, tenant_id, plan_tier, seat_count, seat_limit, seat_limit - seat_count AS seat_headroom FROM fact.fact_seat_assignments WHERE business_date = &lt;[Parameters].[Business Date]&gt; ORDER BY seat_headroom</relation>
</connection>
<aliases enabled='yes' />
<column datatype='date' name='[business_date]' role='dimension' type='ordinal' />
<column datatype='string' name='[tenant_id]' role='dimension' type='nominal' />
<column datatype='string' name='[plan_tier]' role='dimension' type='nominal' />
<column datatype='integer' name='[seat_count]' role='measure' type='quantitative' />
<column datatype='integer' name='[seat_limit]' role='measure' type='quantitative' />
<column datatype='integer' name='[seat_headroom]' role='measure' type='quantitative' />
</datasource>
