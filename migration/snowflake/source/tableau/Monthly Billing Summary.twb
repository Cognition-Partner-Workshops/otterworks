<connection authentication='sqlserver' class='sqlserver' dbname='OtterWorksUBW' odbc-native-protocol='' one-time-sql='' port='14333' server='127.0.0.1' username='sa' />
</named-connection>
</named-connections>
<relation connection='sqlserver.0ba3c0af97b5509f4139a2196de4' name='Custom SQL Query' type='text'>SELECT business_date, line_type, invoice_status, COUNT_BIG(*) AS line_count, SUM(amount_cents) AS amount_cents FROM fact.fact_invoice_lines WHERE business_date = &lt;[Parameters].[Business Date]&gt; GROUP BY business_date, line_type, invoice_status ORDER BY line_type, invoice_status</relation>
</connection>
<aliases enabled='yes' />
<column datatype='date' name='[business_date]' role='dimension' type='ordinal' />
<column datatype='string' name='[line_type]' role='dimension' type='nominal' />
