<relation connection='sqlserver.e19843679c67a5c4c015fb9a4320' name='Custom SQL Query' type='text'>SELECT business_date, tenant_id, plan_tier, seat_count, seat_limit FROM fact.fact_seat_assignments WHERE business_date = &lt;[Parameters].[Business Date]&gt; ORDER BY tenant_id</relation>
</connection>
<aliases enabled='yes' />
<column datatype='date' name='[business_date]' role='dimension' type='ordinal' />
