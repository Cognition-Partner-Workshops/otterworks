<datasource caption="Seat Utilization" inline='true' name='federated.9b4408e20c9d715ccfb639f5de22' version='18.1'>
<connection class='federated'>
<named-connections>
<named-connection caption='127.0.0.1' name='sqlserver.2b6c287317398bcc48c1bb29f767'>
<connection authentication='sqlserver' class='sqlserver' dbname='OtterWorksUBW' odbc-native-protocol='' one-time-sql='' port='14333' server='127.0.0.1' username='sa' />
</named-connection>
</named-connections>
<relation connection='sqlserver.2b6c287317398bcc48c1bb29f767' name='Custom SQL Query' type='text'>SELECT business_date, tenant_id, plan_tier, seat_count, seat_limit, CAST(seat_count AS decimal(18,4)) / NULLIF(seat_limit, 0) AS utilization FROM fact.fact_seat_assignments WHERE business_date = &lt;[Parameters].[Business Date]&gt; ORDER BY utilization DESC</relation>
</connection>
<aliases enabled='yes' />
<column datatype='date' name='[business_date]' role='dimension' type='ordinal' />
<column datatype='string' name='[tenant_id]' role='dimension' type='nominal' />
<column datatype='string' name='[plan_tier]' role='dimension' type='nominal' />
<column datatype='integer' name='[seat_count]' role='measure' type='quantitative' />
<column datatype='integer' name='[seat_limit]' role='measure' type='quantitative' />
<column datatype='real' name='[utilization]' role='measure' type='quantitative' />
</datasource>
