<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" rd:ReportID="bd004a9e-35cc-444e-bba5-d0f9d5d8d28b">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="UBW">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=UBW-SQL01;Initial Catalog=OtterWorksUBW</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>UBW</DataSourceName>
        <CommandText>SELECT business_date, plan_tier, tenant_count, seat_count, seat_limit_total, tenants_over_limit, avg_seats_per_tenant FROM mart.mart_plan_seat_summary WHERE business_date = @BusinessDate AND plan_tier = @PlanTier ORDER BY plan_tier</CommandText>
        <QueryParameters>
          <QueryParameter Name="@BusinessDate">
            <Value>=Parameters!BusinessDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PlanTier">
            <Value>=Parameters!PlanTier.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="business_date">
          <DataField>business_date</DataField>
        </Field>
        <Field Name="plan_tier">
          <DataField>plan_tier</DataField>
        </Field>
        <Field Name="tenant_count">
          <DataField>tenant_count</DataField>
        </Field>
        <Field Name="seat_count">
          <DataField>seat_count</DataField>
        </Field>
        <Field Name="seat_limit_total">
          <DataField>seat_limit_total</DataField>
        </Field>
        <Field Name="tenants_over_limit">
          <DataField>tenants_over_limit</DataField>
        </Field>
        <Field Name="avg_seats_per_tenant">
          <DataField>avg_seats_per_tenant</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="BusinessDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>2026-09-30</Value>
        </Values>
      </DefaultValue>
    </ReportParameter>
    <ReportParameter Name="PlanTier">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>Growth</Value>
        </Values>
      </DefaultValue>
      <ValidValues>
        <ParameterValues>
          <ParameterValue>
            <Label>Starter</Label>
            <Value>Starter</Value>
          </ParameterValue>
          <ParameterValue>
            <Label>Growth</Label>
            <Value>Growth</Value>
          </ParameterValue>
          <ParameterValue>
            <Label>Scale</Label>
            <Value>Scale</Value>
          </ParameterValue>
        </ParameterValues>
      </ValidValues>
    </ReportParameter>
  </ReportParameters>
