<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" rd:ReportID="636eb157-2407-47c8-85cd-d2c09199e9d1">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="UBW">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=UBW-SQL01;Initial Catalog=OtterWorksUBW</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>UBW</DataSourceName>
        <CommandText>SELECT business_date, tenant_id, SUM(amount_cents) AS amount_cents, COUNT(DISTINCT invoice_id) AS invoice_count FROM fact.fact_invoice_lines WHERE business_date = @BusinessDate GROUP BY business_date, tenant_id ORDER BY amount_cents DESC</CommandText>
        <QueryParameters>
          <QueryParameter Name="@BusinessDate">
            <Value>=Parameters!BusinessDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="business_date">
          <DataField>business_date</DataField>
        </Field>
        <Field Name="tenant_id">
          <DataField>tenant_id</DataField>
        </Field>
        <Field Name="amount_cents">
          <DataField>amount_cents</DataField>
        </Field>
        <Field Name="invoice_count">
          <DataField>invoice_count</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="BusinessDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>2026-09-30</Value>
        </Values>
      </DefaultValue>
    </ReportParameter>
  </ReportParameters>
