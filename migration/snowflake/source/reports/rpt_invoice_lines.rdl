  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="UBW">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=UBW-SQL01;Initial Catalog=OtterWorksUBW</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>UBW</DataSourceName>
        <CommandText>SELECT business_date, invoice_id, line_no, tenant_id, period_start, period_end, line_type, description, amount_cents, invoice_status FROM fact.fact_invoice_lines WHERE business_date = @BusinessDate ORDER BY invoice_id, line_no</CommandText>
        <QueryParameters>
          <QueryParameter Name="@BusinessDate">
            <Value>=Parameters!BusinessDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="business_date">
          <DataField>business_date</DataField>
        </Field>
        <Field Name="invoice_id">
          <DataField>invoice_id</DataField>
        </Field>
        <Field Name="line_no">
          <DataField>line_no</DataField>
        </Field>
        <Field Name="tenant_id">
          <DataField>tenant_id</DataField>
        </Field>
        <Field Name="period_start">
          <DataField>period_start</DataField>
        </Field>
        <Field Name="period_end">
          <DataField>period_end</DataField>
        </Field>
        <Field Name="line_type">
          <DataField>line_type</DataField>
        </Field>
        <Field Name="description">
          <DataField>description</DataField>
        </Field>
        <Field Name="amount_cents">
          <DataField>amount_cents</DataField>
        </Field>
        <Field Name="invoice_status">
          <DataField>invoice_status</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="BusinessDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>2026-09-30</Value>
        </Values>
      </DefaultValue>
    </ReportParameter>
  </ReportParameters>
