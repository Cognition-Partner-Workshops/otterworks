  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>UBW</DataSourceName>
        <CommandText>SELECT business_date, tenant_id, observation_date, plan_tier, peak_storage_mb, bytes_used, seat_count, forecast_bytes_30d, forecast_generated_at FROM mart.mart_capacity_forecast_input WHERE business_date = @BusinessDate ORDER BY tenant_id, observation_date</CommandText>
        <QueryParameters>
          <QueryParameter Name="@BusinessDate">
            <Value>=Parameters!BusinessDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="business_date">
          <DataField>business_date</DataField>
        </Field>
        <Field Name="tenant_id">
          <DataField>tenant_id</DataField>
        </Field>
        <Field Name="observation_date">
          <DataField>observation_date</DataField>
        </Field>
        <Field Name="plan_tier">
          <DataField>plan_tier</DataField>
        </Field>
        <Field Name="peak_storage_mb">
          <DataField>peak_storage_mb</DataField>
        </Field>
        <Field Name="bytes_used">
          <DataField>bytes_used</DataField>
        </Field>
        <Field Name="seat_count">
          <DataField>seat_count</DataField>
        </Field>
        <Field Name="forecast_bytes_30d">
          <DataField>forecast_bytes_30d</DataField>
        </Field>
        <Field Name="forecast_generated_at">
          <DataField>forecast_generated_at</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="BusinessDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>2026-09-30</Value>
        </Values>
      </DefaultValue>
    </ReportParameter>
