<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" rd:ReportID="5265625b-677f-4f5f-b83c-211dcffc77ee"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="UBW"><ConnectionProperties><DataProvider>SQL</DataProvider><ConnectString>Data Source=UBW-SQL01;Initial Catalog=OtterWorksUBW</ConnectString></ConnectionProperties></DataSource></DataSources><DataSets><DataSet Name="DataSet1"><Query><DataSourceName>UBW</DataSourceName><CommandText>SELECT business_date, region_code, COUNT_BIG(*) AS tenant_count, SUM(api_units) AS api_units, SUM(compute_units) AS compute_units, SUM(bytes_used) AS bytes_used FROM mart.mart_tenant_usage_daily WHERE business_date = @BusinessDate GROUP BY business_date, region_code ORDER BY region_code</CommandText><QueryParameters><QueryParameter Name="@BusinessDate"><Value>=Parameters!BusinessDate.Value</Value></QueryParameter></QueryParameters></Query><Fields><Field Name="business_date"><DataField>business_date</DataField></Field><Field Name="region_code"><DataField>region_code</DataField></Field><Field Name="tenant_count"><DataField>tenant_count</DataField></Field><Field Name="api_units"><DataField>api_units</DataField></Field><Field Name="compute_units"><DataField>compute_units</DataField></Field><Field Name="bytes_used"><DataField>bytes_used</DataField></Field></Fields></DataSet></DataSets><ReportParameters><ReportParameter Name="BusinessDate"><DataType>DateTime</DataType><DefaultValue><Values><Value>2026-09-30</Value></Values></DefaultValue></ReportParameter></ReportParameters><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixCo