  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="UBW">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=UBW-SQL01;Initial Catalog=OtterWorksUBW</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>UBW</DataSourceName>
        <CommandText>SELECT business_date, tenant_id, workspace_id, status_label, document_count, word_count FROM fact.fact_document_status_daily WHERE business_date = @BusinessDate ORDER BY tenant_id, workspace_id, status_label</CommandText>
        <QueryParameters>
          <QueryParameter Name="@BusinessDate">
            <Value>=Parameters!BusinessDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="business_date">
          <DataField>business_date</DataField>
        </Field>
        <Field Name="tenant_id">
          <DataField>tenant_id</DataField>
        </Field>
        <Field Name="workspace_id">
          <DataField>workspace_id</DataField>
        </Field>
        <Field Name="status_label">
          <DataField>status_label</DataField>
        </Field>
        <Field Name="document_count">
          <DataField>document_count</DataField>
        </Field>
        <Field Name="word_count">
          <DataField>word_count</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="BusinessDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>2026-09-30</Value>
        </Values>
      </DefaultValue>
    </ReportParameter>
