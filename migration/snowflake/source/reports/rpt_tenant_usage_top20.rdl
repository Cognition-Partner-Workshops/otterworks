<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" rd:ReportID="b8be44be-7e6a-4c4b-8b27-2f38929a6d57">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="UBW">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=UBW-SQL01;Initial Catalog=OtterWorksUBW</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>UBW</DataSourceName>
        <CommandText>SELECT TOP (20) business_date, tenant_id, tenant_name, plan_tier, api_units, compute_units, storage_peak_mb, bytes_used FROM mart.mart_tenant_usage_daily WHERE business_date = @BusinessDate ORDER BY bytes_used DESC</CommandText>
        <QueryParameters>
          <QueryParameter Name="@BusinessDate">
            <Value>=Parameters!BusinessDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="business_date">
          <DataField>business_date</DataField>
        </Field>
        <Field Name="tenant_id">
          <DataField>tenant_id</DataField>
        </Field>
        <Field Name="tenant_name">
          <DataField>tenant_name</DataField>
        </Field>
        <Field Name="plan_tier">
          <DataField>plan_tier</DataField>
        </Field>
        <Field Name="api_units">
          <DataField>api_units</DataField>
        </Field>
        <Field Name="compute_units">
          <DataField>compute_units</DataField>
        </Field>
        <Field Name="storage_peak_mb">
          <DataField>storage_peak_mb</DataField>
        </Field>
        <Field Name="bytes_used">
          <DataField>bytes_used</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="BusinessDate">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>2026-09-30</Value>
        </Values>
      </DefaultValue>
    </ReportParameter>
  </ReportParameters>
