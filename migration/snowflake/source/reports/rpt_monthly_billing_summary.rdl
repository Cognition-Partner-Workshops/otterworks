<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" rd:ReportID="b8a0159e-35f2-44af-b3db-ee4d41f7da59"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="UBW"><ConnectionProperties><DataProvider>SQL</DataProvider><ConnectString>Data Source=UBW-SQL01;Initial Catalog=OtterWorksUBW</ConnectString></ConnectionProperties></DataSource></DataSources><DataSets><DataSet Name="DataSet1"><Query><DataSourceName>UBW</DataSourceName><CommandText>SELECT business_date, line_type, invoice_status, COUNT_BIG(*) AS line_count, SUM(amount_cents) AS amount_cents FROM fact.fact_invoice_lines WHERE business_date = @BusinessDate GROUP BY business_date, line_type, invoice_status ORDER BY line_type, invoice_status</CommandText><QueryParameters><QueryParameter Name="@BusinessDate"><Value>=Parameters!BusinessDate.Value</Value></QueryParameter></QueryParameters></Query><Fields><Field Name="business_date"><DataField>business_date</DataField></Field><Field Name="line_type"><DataField>line_type</DataField></Field><Field Name="invoice_status"><DataField>invoice_status</DataField></Field><Field Name="line_count"><DataField>line_count</DataField></Field><Field Name="amount_cents"><DataField>amount_cents</DataField></Field></Fields></DataSet></DataSets><ReportParameters><ReportParameter Name="BusinessDate"><DataType>DateTime</DataType><DefaultValue><Values><Value>2026-09-30</Value></Values></DefaultValue></ReportParameter></ReportParameters><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox0_0"><Paragrap