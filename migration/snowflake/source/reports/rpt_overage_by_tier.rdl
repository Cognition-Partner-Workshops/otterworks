<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" rd:ReportID="9589c340-82be-464e-b586-c7b14b3e9b2b"><AutoRefresh>0</AutoRefresh><DataSources><DataSource Name="UBW"><ConnectionProperties><DataProvider>SQL</DataProvider><ConnectString>Data Source=UBW-SQL01;Initial Catalog=OtterWorksUBW</ConnectString></ConnectionProperties></DataSource></DataSources><DataSets><DataSet Name="DataSet1"><Query><DataSourceName>UBW</DataSourceName><CommandText>SELECT business_date, plan_tier, COUNT_BIG(*) AS tenant_count, SUM(overage_gb) AS overage_gb, SUM(overage_cents) AS overage_cents FROM mart.mart_overage_charges WHERE business_date = @BusinessDate GROUP BY business_date, plan_tier ORDER BY plan_tier</CommandText><QueryParameters><QueryParameter Name="@BusinessDate"><Value>=Parameters!BusinessDate.Value</Value></QueryParameter></QueryParameters></Query><Fields><Field Name="business_date"><DataField>business_date</DataField></Field><Field Name="plan_tier"><DataField>plan_tier</DataField></Field><Field Name="tenant_count"><DataField>tenant_count</DataField></Field><Field Name="overage_gb"><DataField>overage_gb</DataField></Field><Field Name="overage_cents"><DataField>overage_cents</DataField></Field></Fields></DataSet></DataSets><ReportParameters><ReportParameter Name="BusinessDate"><DataType>DateTime</DataType><DefaultValue><Values><Value>2026-09-30</Value></Values></DefaultValue></ReportParameter></ReportParameters><Body><ReportItems><Tablix Name="Tablix1"><TablixBody><TablixColumns><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn><TablixColumn><Width>1.2in</Width></TablixColumn></TablixColumns><TablixRows><TablixRow><Height>0.25in</Height><TablixCells><TablixCell><CellContents><Textbox Name="Textbox0_0"><Paragraphs><Paragraph