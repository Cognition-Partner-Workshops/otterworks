      <DTS:Property DTS:Name="ConnectionString">Data Source=UBW-SQL01;Initial Catalog=OtterWorksUBW;Provider=SQLNCLI11.1;Integrated Security=SSPI;</DTS:Property>
    </DTS:ConnectionManager>
    <DTS:ConnectionManager DTS:ObjectName="FlatFile_files"
      DTS:CreationName="FLATFILE"
