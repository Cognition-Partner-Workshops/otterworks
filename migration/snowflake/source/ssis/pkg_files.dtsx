        <DTS:FlatFileColumn DTS:ObjectName="updated_at"
          DTS:DataType="129"
          DTS:Ordinal="11" />
      </DTS:FlatFileColumns>
      <DTS:ObjectData>
        <DTS:FlatFileConnectionManager DTS:Format="Delimited"
          DTS:ColumnNamesInFirstDataRow="True"
          DTS:RowDelimiter="_x000A_"
          DTS:TextQualifier="&quot;" />
      </DTS:ObjectData>
