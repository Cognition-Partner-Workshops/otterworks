    <DTS:Executable DTS:ObjectName="SQL Update usage watermark"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:DTSID="{7144b4c8-c505-456f-ba42-bb56d1f8bab2}"
      DTS:Disabled="False">
      <SQLTask:SqlTaskData SQLTask:Connection="UBW_Staging" SQLTask:SqlStatementSource="&#10;DECLARE @watermark nvarchar(64) =&#10;    (SELECT CONVERT(nvarchar(64), MAX(occurred_at), 126) FROM stg.stg_billing_usage_events);&#10;IF @watermark IS NOT NULL&#10;BEGIN&#10;    IF EXISTS (SELECT 1 FROM ops.parity_watermarks WHERE object_name = 'pkg_billing_usage')&#10;        UPDATE ops.parity_watermarks&#10;        SET watermark_value = @watermark,&#10;            business_date = CAST(@[$Package::BusinessDate] AS date),&#10;            updated_at = GETDATE()&#10;        WHERE object_name = 'pkg_billing_usage';&#10;    ELSE&#10;        INSERT INTO ops.parity_watermarks&#10;            (object_name, watermark_column, watermark_value, business_date, updated_at)&#10;        VALUES&#10;            ('pkg_billing_usage', 'occurred_at', @watermark,&#10;             CAST(@[$Package::BusinessDate] AS date), GETDATE());&#10;END;&#10;" SQLTask:ResultType="ResultSetType_None" />
      <DTS:Annotations>
        <DTS:Annotation DTS:Name="SQL Update usage watermark">
          <DTS:Text>Executes sql update usage watermark before the data flow.</DTS:Text>
        </DTS:Annotation>
      </DTS:Annotations>
    </DTS:Executable>
