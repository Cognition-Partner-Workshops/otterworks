          <pipeline:component pipeline:Name="LKP Tenant from user" pipeline:ComponentType="Lookup" pipeline:ID="{76d6326e-5b3a-46ca-8d21-f43d6257550a}" pipeline:Version="1">
            <pipeline:Property pipeline:name="JoinInput">user_id</pipeline:Property>
