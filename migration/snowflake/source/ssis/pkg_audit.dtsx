            <pipeline:Property pipeline:name="Outputs">tenant_id=tenant_id</pipeline:Property>
            <pipeline:Property pipeline:name="ReferenceFile" />
            <pipeline:Property pipeline:name="ReferenceQuery">SELECT user_id, MIN(tenant_id) AS tenant_id FROM stg.stg_auth_workspace_members GROUP BY user_id</pipeline:Property>
