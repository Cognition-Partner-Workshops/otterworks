      <DTS:Property DTS:Name="DesignTimeProperties">&lt;DesignTimeProperties /&gt;</DTS:Property>
      <pipeline:Pipeline>
        <pipeline:components>
          <pipeline:component pipeline:Name="FF_SRC analytics_events.csv" pipeline:ComponentType="FlatFileSource" pipeline:ID="{b388d7ee-7427-41e4-b0c2-a9594dfca851}" pipeline:Version="1" pipeline:ConnectionManager="FlatFile_analytics_events">
            <pipeline:Property pipeline:name="HeaderRowDelimiter">_x000A_</pipeline:Property>
            <pipeline:Property pipeline:name="DataRowsToSkip">0</pipeline:Property>
          </pipeline:component>
          <pipeline:component pipeline:Name="LKP Tenant from user" pipeline:ComponentType="Lookup" pipeline:ID="{1e593614-0cf1-4d30-9d8f-24fe6189bf75}" pipeline:Version="1">
            <pipeline:Property pipeline:name="JoinInput">user_id</pipeline:Property>
            <pipeline:Property pipeline:name="JoinReference">user_id</pipeline:Property>
            <pipeline:Property pipeline:name="Outputs">tenant_id=tenant_id</pipeline:Property>
            <pipeline:Property pipeline:name="ReferenceFile" />
            <pipeline:Property pipeline:name="ReferenceQuery">SELECT user_id, MIN(tenant_id) AS tenant_id FROM stg.stg_auth_workspace_members GROUP BY user_id</pipeline:Property>
          </pipeline:component>
          <pipeline:component pipeline:Name="DER Normalise timestamps" pipeline:ComponentType="DerivedColumn" pipeline:ID="{75e740e4-c06f-4491-a6ba-8e4d0b089b2a}" pipeline:Version="1">
            <pipeline:Expression pipeline:output="event_ts_utc" pipeline:expression="DATEADD(&quot;ss&quot;,(DT_I4)(occurred_at / 1000000000),(DT_DBTIMESTAMP2,7)&quot;1970-01-01 00:00:00&quot;)" />
            <pipeline:Expression pipeline:output="extracted_at" pipeline:expression="@[System::StartTime]" />
            <pipeline:Expression pipeline:output="source_system" pipeline:expression="&quot;analytics-service&quot;" />
          </pipeline:component>
          <pipeline:component pipeline:Name="OLE_DST stg_analytics_events" pipeline:ComponentType="OLEDBDestination" pipeline:ID="{5a8039f2-d955-4a68-a93f-fbb07e542e77}" pipeline:Version="1" pipeline:ConnectionManager="UBW_Staging">
            <pipeline:Property pipeline:name="TableName">[stg].[stg_analytics_events]</pipeline:Property>
            <pipeline:Mappings>
