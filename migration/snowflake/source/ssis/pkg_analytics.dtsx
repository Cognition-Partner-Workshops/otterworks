              <pipeline:Mapping pipeline:input="event_type" pipeline:destination="event_type" />
              <pipeline:Mapping pipeline:input="user_id" pipeline:destination="user_id" />
              <pipeline:Mapping pipeline:input="resource_id" pipeline:destination="resource_id" />
              <pipeline:Mapping pipeline:input="resource_type" pipeline:destination="resource_type" />
              <pipeline:Mapping pipeline:input="metadata" pipeline:destination="metadata" />
              <pipeline:Mapping pipeline:input="occurred_at" pipeline:destination="occurred_at" />
              <pipeline:Mapping pipeline:input="event_ts_utc" pipeline:destination="event_ts_utc" />
              <pipeline:Mapping pipeline:input="row_checksum" pipeline:destination="row_checksum" />
              <pipeline:Mapping pipeline:input="tenant_id" pipeline:destination="tenant_id" />
              <pipeline:Mapping pipeline:input="extracted_at" pipeline:destination="extracted_at" />
              <pipeline:Mapping pipeline:input="source_system" pipeline:destination="source_system" />
            </pipeline:Mappings>
          </pipeline:component>
