</named-connection>
</named-connections>
<relation connection='snowflake.fd5b9a2194552b939dc994084dc4' name='Custom SQL Query' type='text'>SELECT business_date, plan_tier, COUNT(*) AS tenant_count, SUM(overage_gb) AS overage_gb, SUM(overage_cents) AS overage_cents FROM MARTS.BUILD_MART_OVERAGE WHERE business_date = &lt;[Parameters].[Business Date]&gt; GROUP BY business_date, plan_tier ORDER BY plan_tier</relation>
</connection>
<aliases enabled='yes' />
