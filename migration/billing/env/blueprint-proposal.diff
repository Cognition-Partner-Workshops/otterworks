+  # Billing migration workers (Oracle OW_BILLING -> MongoDB Atlas, tp-run/mongodb-* branches).
+  # Connectivity policy d-connectivity-policy = auto: live through the named secrets
+  # MONGODB_ATLAS_URI / OW_TP_ORACLE_RO_DSN when set and reachable, local fallback otherwise.
+  # Standard tools only: mongosh + Database Tools (org blueprint), Atlas CLI (mise, above),
+  # uv for the repo validators, python-oracledb (thin) + pymongo in a dedicated venv, and
+  # the offline fallbacks: the mongo:7 image, plus the Oracle Free image pre-pulled above
+  # and started per session with `make oracle-billing-up` (containers never persist here).
+  mkdir -p /home/ubuntu/.venvs
+  [ -x /home/ubuntu/.venvs/ow-billing/bin/python ] || "$HOME/.local/bin/uv" venv --python /usr/bin/python3 /home/ubuntu/.venvs/ow-billing
+  "$HOME/.local/bin/uv" pip install --python /home/ubuntu/.venvs/ow-billing/bin/python "oracledb==2.5.1" "pymongo==4.10.1"
+  docker pull mongo:7 || true
+  # Post-setup checks, auto policy: a live miss is reported, not fatal, so a session still
+  # boots and takes the fallback (migration/billing/env/postsetup-check.sh on the run branch
+  # re-runs these per session, with the fallback path and `make tp-validate-schemas`).
+  if [ -n "${MONGODB_ATLAS_URI:-}" ]; then
+    timeout 60 mongosh "$MONGODB_ATLAS_URI" --quiet --eval 'print("atlas ping ok="+db.adminCommand({ping:1}).ok)' || echo "atlas ping FAILED; sessions fall back to mongo:7"
+  else echo "MONGODB_ATLAS_URI not set; sessions fall back to mongo:7"; fi
+  if [ -n "${OW_TP_ORACLE_RO_DSN:-}" ]; then
+    timeout 90 /home/ubuntu/.venvs/ow-billing/bin/python - <<'PY' || echo "oracle SELECT 1 FAILED; sessions fall back to make oracle-billing-up"
+  import json, os, oracledb
+  raw = os.environ["OW_TP_ORACLE_RO_DSN"]
+  try:
+      c = json.loads(raw); kw = dict(user=c["user"], password=c["password"], dsn=c["dsn"])
+  except (ValueError, KeyError, TypeError):
+      kw = dict(dsn=raw)
+  with oracledb.connect(**kw) as con:
+      cur = con.cursor(); cur.execute("SELECT 1 FROM dual")
+      print("oracle SELECT 1 ok=%s thin=%s" % (cur.fetchone()[0], oracledb.is_thin_mode()))
+  PY
+  else echo "OW_TP_ORACLE_RO_DSN not set; sessions fall back to make oracle-billing-up"; fi
+  if grep -q '^tp-validate-schemas:' Makefile 2>/dev/null; then make tp-validate-schemas; else echo "tp-validate-schemas: not on this branch; run it on the tp-run branch via postsetup-check.sh"; fi
 # Install project dependencies (runs during builds, surfaced to agent at session start).
