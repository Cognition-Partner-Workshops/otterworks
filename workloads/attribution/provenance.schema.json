{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cognition-Partner-Workshops/otterworks/workloads/attribution/provenance.schema.json",
  "title": "OtterWorks Snowflake workload provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workload", "run_token", "expires", "application", "source", "endpoints", "query_tag", "warehouse", "objects", "usage"],
  "properties": {
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "deployed"],
      "properties": {
        "installed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "name", "revision", "run_id", "status", "installed_at", "query_ids", "readback"],
            "allOf": [{
              "if": {"properties": {"type": {"enum": ["procedure", "task", "streamlit", "model_refresh", "table", "stage"]}}},
              "then": {"properties": {"name": {"pattern": "^[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*$"}}}
            }],
            "properties": {
              "type": {"enum": ["procedure", "task", "migration", "streamlit", "model_refresh", "table", "view", "stage", "warehouse", "database", "schema", "user", "resource_monitor", "runtime_source"]},
              "name": {"oneOf": [{"$ref": "#/$defs/object_name"}, {"type": "string", "pattern": "^workloads/[a-z0-9_]+/responder/[a-z0-9_]+\\.py$"}]},
              "revision": {"$ref": "#/$defs/commit"},
              "run_id": {"type": "string", "minLength": 1},
              "status": {"enum": ["installed", "failed"]},
              "installed_at": {"$ref": "#/$defs/utc_timestamp"},
              "timestamp_source": {"enum": ["statement_completed_at", "metadata_last_altered", "run_finished_at_upper_bound", "schemachange_installed_on"]},
              "query_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "readback": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "reason"],
                "properties": {
                  "status": {"enum": ["verified", "unavailable", "not_checked"]},
                  "reason": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "attempted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "mode", "run_id", "started_at", "finished_at", "status", "failed_step", "gate", "failing_tests"],
          "properties": {
            "commit": {"$ref": "#/$defs/commit"},
            "mode": {"enum": ["deploy", "rollback", "dry-run"]},
            "run_id": {"type": "string", "minLength": 1},
            "started_at": {"$ref": "#/$defs/utc_timestamp"},
            "finished_at": {"$ref": "#/$defs/utc_timestamp"},
            "status": {"enum": ["succeeded", "failed"]},
            "failed_step": {"type": ["string", "null"]},
            "gate": {"type": ["string", "null"]},
            "failing_tests": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "retained_table_policy": {"type": "string", "minLength": 1},
            "retained_table_result": {"enum": ["passed", "failed"]},
            "failed_gates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["gate", "detail"],
                "properties": {
                  "gate": {"type": "string", "minLength": 1},
                  "detail": {"type": "string", "minLength": 1}
                }
              }
            }
          },
          "allOf": [{
            "if": {"properties": {"status": {"const": "failed"}}},
            "then": {"properties": {"failed_step": {"type": "string", "minLength": 1}, "gate": {"type": "string", "minLength": 1}}},
            "else": {"properties": {"failed_step": {"type": "null"}, "gate": {"type": "null"}, "failing_tests": {"maxItems": 0}, "failed_gates": {"maxItems": 0}}}
          }]
        },
        "deployed": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["commit", "mode", "run_id", "deployed_at", "objects"],
              "properties": {
                "commit": {"$ref": "#/$defs/commit"},
                "mode": {"enum": ["deploy", "rollback", "dry-run"]},
                "run_id": {"type": "string", "minLength": 1},
                "deployed_at": {"$ref": "#/$defs/utc_timestamp"},
                "objects": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "name", "detail"],
                    "properties": {
                      "type": {"enum": ["migrations", "procedure", "task", "model", "tests", "streamlit"]},
                      "name": {"type": "string", "minLength": 1},
                      "detail": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "configuration_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["object", "setting", "from", "to", "migration", "reason", "status", "environment", "evidence"],
        "properties": {
          "object": {"$ref": "#/$defs/object_name"},
          "setting": {"type": "string", "minLength": 1},
          "from": {"type": ["string", "number", "boolean"]},
          "to": {"type": ["string", "number", "boolean"]},
          "migration": {"type": "string", "pattern": "^workloads/[a-z0-9_]+/migrations/V[0-9.]+__[a-z0-9_]+\\.sql$"},
          "reason": {"type": "string", "pattern": "\\S"},
          "status": {"enum": ["planned", "applied"]},
          "environment": {"type": "string", "minLength": 1},
          "applied_query_id": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["query_id", "time", "user", "role", "query_tag", "statement"],
              "properties": {
                "query_id": {"type": "string", "minLength": 1},
                "time": {"$ref": "#/$defs/utc_timestamp"},
                "user": {"type": "string", "minLength": 1},
                "role": {"type": "string", "minLength": 1},
                "query_tag": {"type": "string"},
                "statement": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "ran_at", "commit", "refresh_task_run", "tests"],
      "properties": {
        "suite": {"type": "string", "pattern": "^tag:dq_[a-z0-9_]+$"},
        "ran_at": {"$ref": "#/$defs/utc_timestamp"},
        "commit": {"$ref": "#/$defs/commit"},
        "refresh_task_run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["query_id", "graph_run_group_id", "scheduled_time"],
          "properties": {
            "query_id": {"type": "string", "minLength": 1},
            "graph_run_group_id": {"type": "string", "minLength": 1},
            "scheduled_time": {"$ref": "#/$defs/utc_timestamp"}
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "check", "status", "failing_rows", "cause"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "check": {"enum": ["freshness", "row_count", "uniqueness", "accepted_range", "worked_example"]},
              "status": {"enum": ["pass", "fail"]},
              "failing_rows": {"type": "integer", "minimum": 0},
              "cause": {"type": "string"}
            },
            "allOf": [{
              "if": {"properties": {"status": {"const": "fail"}}},
              "then": {"properties": {"failing_rows": {"minimum": 1}, "cause": {"pattern": "\\S"}}},
              "else": {"properties": {"failing_rows": {"const": 0}}}
            }]
          }
        }
      }
    },
    "schema_version": {"const": 1},
    "workload": {"$ref": "#/$defs/identifier"},
    "run_token": {"type": "string", "pattern": "^SF[A-Z]+_[0-9]{8}[A-Z]?$"},
    "expires": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "registration"],
      "properties": {
        "name": {"const": "Devin_Demo"},
        "registration": {"const": "unregistered"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base_branch", "base_commit", "commit", "pull_request", "session_url"],
      "properties": {
        "repository": {"const": "Cognition-Partner-Workshops/otterworks"},
        "base_branch": {"type": "string", "minLength": 1},
        "base_commit": {"$ref": "#/$defs/commit"},
        "commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"const": "pending"}]},
        "pull_request": {
          "oneOf": [
            {"type": "string", "pattern": "^https://github\\.com/Cognition-Partner-Workshops/otterworks/pull/[0-9]+$"},
            {"const": "pending"}
          ]
        },
        "session_url": {"$ref": "#/$defs/session_url"}
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["csid", "service_user", "auth"],
        "properties": {
          "csid": {"$ref": "#/$defs/csid"},
          "service_user": {"type": "string", "pattern": "^SVC_CS_[A-Z][A-Z0-9]*(_[A-Z0-9]+)+$"},
          "auth": {"const": "key_pair"},
          "role": {"$ref": "#/$defs/object_name"},
          "runtime_source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "revision"],
            "properties": {
              "path": {"type": "string", "pattern": "^workloads/[a-z0-9_]+/responder/[a-z0-9_]+\\.py$"},
              "revision": {"oneOf": [{"$ref": "#/$defs/commit"}, {"const": "pending"}]}
            }
          }
        }
      }
    },
    "query_tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys", "dev_keys", "task_phase"],
      "properties": {
        "keys": {"const": ["csid", "workload", "phase", "commit", "run_id"]},
        "dev_keys": {"const": ["session_url"]},
        "task_phase": {"const": "runtime"}
      }
    },
    "warehouse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "auto_suspend_seconds", "resource_monitor"],
      "properties": {
        "name": {"$ref": "#/$defs/object_name"},
        "size": {"enum": ["XSMALL", "LARGE"]},
        "auto_suspend_seconds": {"enum": [60, 900]},
        "resource_monitor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "frequency", "credit_quota"],
          "properties": {
            "name": {"$ref": "#/$defs/object_name"},
            "frequency": {"const": "MONTHLY"},
            "credit_quota": {"type": "integer", "minimum": 1},
            "administrative_change": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actor", "reason", "from", "to", "evidence_query_ids", "observed_used_credits", "unchanged"],
              "properties": {
                "actor": {"const": "administrator"},
                "reason": {"type": "string", "minLength": 1},
                "from": {"type": "integer", "minimum": 1},
                "to": {"type": "integer", "minimum": 1},
                "evidence_query_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "observed_used_credits": {"type": "number", "minimum": 0},
                "unchanged": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["notify_percent", "suspend_percent", "suspend_immediate_percent", "end_date"],
                  "properties": {
                    "notify_percent": {"const": 80},
                    "suspend_percent": {"const": 90},
                    "suspend_immediate_percent": {"const": 100},
                    "end_date": {"type": "string", "format": "date"}
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"size": {"const": "XSMALL"}}},
        "then": {"properties": {"auto_suspend_seconds": {"const": 60}}}
      }]
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "state"],
        "properties": {
          "type": {"enum": ["database", "schema", "warehouse", "resource_monitor", "user", "task", "streamlit"]},
          "name": {"$ref": "#/$defs/object_name"},
          "devin_csid": {"type": "string", "pattern": "^cs_[a-z0-9_]+(,cs_[a-z0-9_]+)*$", "maxLength": 256},
          "comment": {"type": "string", "minLength": 1},
          "state": {"enum": ["planned", "provisioned", "dropped"]}
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reported_through", "dev", "runtime", "cortex"],
      "properties": {
        "source": {"const": "SNOWFLAKE.ACCOUNT_USAGE"},
        "reported_through": {"oneOf": [{"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, {"const": "pending"}]},
        "dev": {"$ref": "#/$defs/compute_usage"},
        "runtime": {"$ref": "#/$defs/compute_usage"},
        "cortex": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dev", "runtime"],
          "properties": {
            "dev": {"$ref": "#/$defs/cortex_usage"},
            "runtime": {"$ref": "#/$defs/cortex_usage"}
          }
        }
      }
    }
  },
  "$defs": {
    "utc_timestamp": {"type": "string", "format": "date-time", "pattern": "(Z|\\+00:00)$"},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"},
    "csid": {"type": "string", "pattern": "^cs_[a-z][a-z0-9]*(_[a-z0-9]+)+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "session_url": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+/sessions/[0-9a-f]{32}$"},
    "object_name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*){0,2}$"},
    "usage_value": {"oneOf": [{"type": "number", "minimum": 0}, {"const": "pending"}]},
    "compute_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compute_credits", "query_acceleration_credits", "query_count"],
      "properties": {
        "compute_credits": {"$ref": "#/$defs/usage_value"},
        "query_acceleration_credits": {"$ref": "#/$defs/usage_value"},
        "query_count": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "pending"}]}
      }
    },
    "cortex_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cortex_credits", "cortex_tokens"],
      "properties": {
        "cortex_credits": {"$ref": "#/$defs/usage_value"},
        "cortex_tokens": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "pending"}]}
      }
    }
  }
}
