{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cognition-Partner-Workshops/otterworks/workloads/attribution/provenance.schema.json",
  "title": "OtterWorks Snowflake workload provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workload", "run_token", "expires", "application", "source", "endpoints", "query_tag", "warehouse", "objects", "usage"],
  "properties": {
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "ran_at", "commit", "refresh_task_run", "tests"],
      "properties": {
        "suite": {"type": "string", "pattern": "^tag:dq_[a-z0-9_]+$"},
        "ran_at": {"$ref": "#/$defs/utc_timestamp"},
        "commit": {"$ref": "#/$defs/commit"},
        "refresh_task_run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["query_id", "graph_run_group_id", "scheduled_time"],
          "properties": {
            "query_id": {"type": "string", "minLength": 1},
            "graph_run_group_id": {"type": "string", "minLength": 1},
            "scheduled_time": {"$ref": "#/$defs/utc_timestamp"}
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "check", "status", "failing_rows", "cause"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "check": {"enum": ["freshness", "row_count", "uniqueness", "accepted_range", "worked_example"]},
              "status": {"enum": ["pass", "fail"]},
              "failing_rows": {"type": "integer", "minimum": 0},
              "cause": {"type": "string"}
            },
            "allOf": [{
              "if": {"properties": {"status": {"const": "fail"}}},
              "then": {"properties": {"failing_rows": {"minimum": 1}, "cause": {"pattern": "\\S"}}},
              "else": {"properties": {"failing_rows": {"const": 0}}}
            }]
          }
        }
      }
    },
    "schema_version": {"const": 1},
    "workload": {"$ref": "#/$defs/identifier"},
    "run_token": {"type": "string", "pattern": "^SF[A-Z]+_[0-9]{8}[A-Z]?$"},
    "expires": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "registration"],
      "properties": {
        "name": {"const": "Devin_Demo"},
        "registration": {"const": "unregistered"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base_branch", "base_commit", "commit", "pull_request", "session_url"],
      "properties": {
        "repository": {"const": "Cognition-Partner-Workshops/otterworks"},
        "base_branch": {"type": "string", "minLength": 1},
        "base_commit": {"$ref": "#/$defs/commit"},
        "commit": {"oneOf": [{"$ref": "#/$defs/commit"}, {"const": "pending"}]},
        "pull_request": {
          "oneOf": [
            {"type": "string", "pattern": "^https://github\\.com/Cognition-Partner-Workshops/otterworks/pull/[0-9]+$"},
            {"const": "pending"}
          ]
        },
        "session_url": {"$ref": "#/$defs/session_url"}
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["csid", "service_user", "auth"],
        "properties": {
          "csid": {"$ref": "#/$defs/csid"},
          "service_user": {"type": "string", "pattern": "^SVC_CS_[A-Z][A-Z0-9]*(_[A-Z0-9]+)+$"},
          "auth": {"const": "key_pair"}
        }
      }
    },
    "query_tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys", "dev_keys", "task_phase"],
      "properties": {
        "keys": {"const": ["csid", "workload", "phase", "commit", "run_id"]},
        "dev_keys": {"const": ["session_url"]},
        "task_phase": {"const": "runtime"}
      }
    },
    "warehouse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "auto_suspend_seconds", "resource_monitor"],
      "properties": {
        "name": {"$ref": "#/$defs/object_name"},
        "size": {"enum": ["XSMALL", "LARGE"]},
        "auto_suspend_seconds": {"const": 60},
        "resource_monitor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "frequency", "credit_quota"],
          "properties": {
            "name": {"$ref": "#/$defs/object_name"},
            "frequency": {"const": "MONTHLY"},
            "credit_quota": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name", "state"],
        "properties": {
          "type": {"enum": ["database", "schema", "warehouse", "resource_monitor", "user", "task", "streamlit"]},
          "name": {"$ref": "#/$defs/object_name"},
          "devin_csid": {"type": "string", "pattern": "^cs_[a-z0-9_]+(,cs_[a-z0-9_]+)*$", "maxLength": 256},
          "comment": {"type": "string", "minLength": 1},
          "state": {"enum": ["planned", "provisioned", "dropped"]}
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reported_through", "dev", "runtime", "cortex"],
      "properties": {
        "source": {"const": "SNOWFLAKE.ACCOUNT_USAGE"},
        "reported_through": {"oneOf": [{"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, {"const": "pending"}]},
        "dev": {"$ref": "#/$defs/compute_usage"},
        "runtime": {"$ref": "#/$defs/compute_usage"},
        "cortex": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dev", "runtime"],
          "properties": {
            "dev": {"$ref": "#/$defs/cortex_usage"},
            "runtime": {"$ref": "#/$defs/cortex_usage"}
          }
        }
      }
    }
  },
  "$defs": {
    "utc_timestamp": {"type": "string", "format": "date-time", "pattern": "(Z|\\+00:00)$"},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"},
    "csid": {"type": "string", "pattern": "^cs_[a-z][a-z0-9]*(_[a-z0-9]+)+$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "session_url": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+/sessions/[0-9a-f]{32}$"},
    "object_name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z][A-Z0-9_]*){0,2}$"},
    "usage_value": {"oneOf": [{"type": "number", "minimum": 0}, {"const": "pending"}]},
    "compute_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compute_credits", "query_acceleration_credits", "query_count"],
      "properties": {
        "compute_credits": {"$ref": "#/$defs/usage_value"},
        "query_acceleration_credits": {"$ref": "#/$defs/usage_value"},
        "query_count": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "pending"}]}
      }
    },
    "cortex_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cortex_credits", "cortex_tokens"],
      "properties": {
        "cortex_credits": {"$ref": "#/$defs/usage_value"},
        "cortex_tokens": {"oneOf": [{"type": "integer", "minimum": 0}, {"const": "pending"}]}
      }
    }
  }
}
