{
  "uid": "otterworks-kyc-upload-latency",
  "title": "OtterWorks - KYC Upload Latency",
  "tags": [
    "otterworks",
    "bank",
    "slo",
    "document-service"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "Prometheus"
        },
        "enable": true,
        "name": "KYC upload alerts",
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\", slo=\"kyc-upload-latency\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}}"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "KYC document uploads - POST /api/v1/documents/ on document-service",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Upload latency p99 against the 2 s objective",
      "description": "KycUploadLatencyP99High pages the platform on-call when the 5m p99 stays above 2 s for 10 m; KycUploadLatencyP99Elevated warns the platform channel above 1.5 s for 15 m.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1.5
              },
              {
                "color": "red",
                "value": 2.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "job:kyc_upload_duration_seconds:p99",
          "legendFormat": "p99 (5m, recording rule)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"document-service\",handler=~\"/api/v1/documents/?\",method=\"POST\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"document-service\",handler=~\"/api/v1/documents/?\",method=\"POST\"}[5m])))",
          "legendFormat": "p50",
          "refId": "C"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "30-day objective: uploads under 2 s (target 99%)",
      "description": "job:kyc_upload_within_2s:ratio_rate30d - share of uploads in the 30-day window that finished inside 2 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "job:kyc_upload_within_2s:ratio_rate30d",
          "legendFormat": "under 2 s",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Upload rate and uploads in flight",
      "description": "A flat rate with climbing latency points at the service or its storage; a burst points at the branches' morning peak.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"document-service\",handler=~\"/api/v1/documents/?\",method=\"POST\"}[5m]))",
          "legendFormat": "uploads / s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(http_requests_inprogress{job=\"document-service\",handler=~\"/api/v1/documents/?\",method=\"POST\"})",
          "legendFormat": "in flight",
          "refId": "B"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Storage backend: SQL statement latency p95 and SQL time per upload",
      "description": "Rising per-statement latency means Postgres is slow (see the runbook). Flat SQL time under a rising upload p99 points away from storage.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(otterworks_db_query_duration_seconds_bucket{job=\"document-service\"}[5m])))",
          "legendFormat": "SQL p95 per statement",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(otterworks_db_query_duration_seconds_sum{job=\"document-service\"}[5m])) / sum(rate(http_requests_total{job=\"document-service\",handler=~\"/api/v1/documents/?\",method=\"POST\"}[5m]))",
          "legendFormat": "SQL seconds per upload",
          "refId": "B"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Client: mean upload body size",
      "description": "Bigger scans take longer to stream from the branch; a rising body size with flat SQL time points at the client side.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(http_request_size_bytes_sum{job=\"document-service\",handler=~\"/api/v1/documents/?\",method=\"POST\"}[5m])) / sum(rate(http_request_size_bytes_count{job=\"document-service\",handler=~\"/api/v1/documents/?\",method=\"POST\"}[5m]))",
          "legendFormat": "mean body size",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "table",
      "title": "Firing KYC upload alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "team": 2,
              "service": 3,
              "slo": 4
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\", slo=\"kyc-upload-latency\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "id": 7
    }
  ]
}
