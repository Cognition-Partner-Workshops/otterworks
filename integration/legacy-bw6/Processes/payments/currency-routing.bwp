<?xml version="1.0" encoding="UTF-8"?>
<bpws:process name="halvergate.payments.currency-routing" targetNamespace="urn:halvergate:integration:payments" suppressJoinFailure="yes" exitOnStandardFault="no" xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions" xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext">
  <bpws:import namespace="urn:halvergate:integration:request" location="../../Schemas/request.xsd" importType="http://www.w3.org/2001/XMLSchema"/>
  <bpws:variables><bpws:variable name="Receive" element="request"/><bpws:variable name="DispatchResponse" element="response"/></bpws:variables>
  <bpws:faultHandlers><bpws:catchAll><bpws:sequence name="RollbackAndRedeliver">      <bpws:extensionActivity>
        <tibex:activityExtension name="RejectDelivery"><tibex:config>
          <bwext:BWActivity activityTypeID="bw.jms.JMSConfirm"><activityConfig><acknowledge>false</acknowledge><maxRedelivery>3</maxRedelivery><undeliveredQueue>HB.UNDLV</undeliveredQueue></activityConfig></bwext:BWActivity>
        </tibex:config></tibex:activityExtension>
      </bpws:extensionActivity>
</bpws:sequence></bpws:catchAll></bpws:faultHandlers>
  <bpws:sequence name="Execute">
      <bpws:extensionActivity>
        <tibex:activityExtension name="Receive"><tibex:config>
          <bwext:BWActivity activityTypeID="bw.jms.JMSQueueReceiver"><activityConfig><connection>SharedResources/EmsConnection.sharedresource</connection><destination>HB.CURRENCY.ROUTING</destination><acknowledgeMode>CLIENT_ACKNOWLEDGE</acknowledgeMode><deliveryMode>PERSISTENT</deliveryMode><selector></selector><durableSubscriber></durableSubscriber><sequencingKey>accountId</sequencingKey></activityConfig></bwext:BWActivity>
        </tibex:config></tibex:activityExtension>
      </bpws:extensionActivity>
      <bpws:extensionActivity>
        <tibex:activityExtension name="MapRecord"><tibex:config>
          <bwext:BWActivity activityTypeID="bw.xml.TransformXML"><activityConfig><stylesheet>Transforms/currency-routing.xsl</stylesheet><inputVariable>Receive</inputVariable></activityConfig></bwext:BWActivity>
        </tibex:config></tibex:activityExtension>
      </bpws:extensionActivity>
      <bpws:if name="RouteCurrency"><bpws:condition>$Receive/currency = 'USD'</bpws:condition><bpws:assign name="DomesticClearing"/><bpws:else><bpws:assign name="CrossBorderClearing"/></bpws:else></bpws:if>
      <bpws:extensionActivity>
        <tibex:activityExtension name="Publish"><tibex:config>
          <bwext:BWActivity activityTypeID="bw.jms.JMSSendMessage"><activityConfig><connection>SharedResources/EmsConnection.sharedresource</connection><destination>HB.CURRENCY.ROUTED</destination><destinationType>QUEUE</destinationType><deliveryMode>PERSISTENT</deliveryMode><properties>requestId,accountId,JMSXGroupID,sequence</properties></activityConfig></bwext:BWActivity>
        </tibex:config></tibex:activityExtension>
      </bpws:extensionActivity>
  </bpws:sequence>
</bpws:process>
