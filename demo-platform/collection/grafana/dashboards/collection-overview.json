{
  "uid": "collection-overview",
  "title": "Collection overview (synthetic)",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "2026-10-01T00:00:00Z",
    "to": "2026-11-01T00:00:00Z"
  },
  "tags": [
    "collection",
    "synthetic"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rows loaded per day",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "collection-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "collection-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('day', started_at) AS time, sum(rows_loaded) AS rows_loaded FROM collection.job_runs WHERE $__timeFilter(started_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Failed runs per day",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "collection-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "collection-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_trunc('day', started_at) AS time, count(*) AS failed FROM collection.job_runs WHERE status = 'failed' AND $__timeFilter(started_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Open alerts by severity",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "collection-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "collection-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT severity, count(*) AS open FROM collection.alerts WHERE resolved_at IS NULL GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Mock Slack messages",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "collection-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "collection-prom"
          },
          "expr": "collection_slack_messages_total"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Devin bridge sessions / forwards",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "collection-prom"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "collection-prom"
          },
          "expr": "collection_slack_sessions_created_total or collection_slack_forwards_total"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Bridge HTTP failures",
      "gridPos": {
