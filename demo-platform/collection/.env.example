# Example values only. `make env` writes a real .env (mode 600, git-ignored) with random secrets.
COMPOSE_PROJECT_NAME=collection-example01
COLLECTION_PG_OWNER_PASSWORD=example-owner-password
COLLECTION_PG_READER_PASSWORD=example-reader-password
COLLECTION_GRAFANA_ADMIN_PASSWORD=example-admin-password
COLLECTION_ACCESS_TOKEN=example-ui-access-token-change-me
COLLECTION_APP_PORT=58780
COLLECTION_GRAFANA_PORT=53000
COLLECTION_PROM_PORT=59090
COLLECTION_PG_PORT=55432

# stub (default) never calls any API. live needs all three server-side values below.
COLLECTION_MODE=stub
# DEVIN_API_KEY is read from the server environment only; do not write it into this file.
COLLECTION_DEVIN_ORG_ID=
COLLECTION_CREATE_AS_USER_ID=
COLLECTION_REPOS=
COLLECTION_MAX_ACU_LIMIT=

# Optional single webhook:incoming automation target (https, allowlisted host).
COLLECTION_AUTOMATION_URL=
COLLECTION_AUTOMATION_ALLOWED_HOST=
COLLECTION_AUTOMATION_SECRET=
# e.g. mention:collection-ops;alert:alerts:\bSEV[12]\b
COLLECTION_AUTOMATION_RULES=
