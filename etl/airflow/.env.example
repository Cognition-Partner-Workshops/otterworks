# OtterWorks ETL on Airflow: local Connections and Variables (etl/airflow/CONFIG.md).
# `make airflow-up` copies this file to etl/airflow/.env (untracked) when it is missing;
# Compose passes it to every Airflow container. Dev credentials and local endpoints only:
# everything points at docker-compose.infra.yml on otterworks-network. Never put a value
# from the removed etl/config.ini (git history) here.
#
# Connections use Airflow's JSON form. Variables are read with Variable.get(key); numbers
# and booleans are JSON literals, read with Variable.get(key, deserialize_json=True).

# --- Connections ---
AIRFLOW_CONN_AWS_DEFAULT='{"conn_type": "aws", "login": "test", "password": "test", "extra": {"region_name": "us-east-1", "endpoint_url": "http://localstack:4566"}}'
AIRFLOW_CONN_OTTERWORKS_POSTGRES='{"conn_type": "postgres", "host": "postgres", "port": 5432, "schema": "otterworks", "login": "otterworks", "password": "otterworks_dev"}'
AIRFLOW_CONN_OTTERWORKS_MEILISEARCH='{"conn_type": "http", "host": "meilisearch", "port": 7700, "schema": "http", "password": ""}'
AIRFLOW_CONN_OTTERWORKS_DOCUMENT_SERVICE='{"conn_type": "http", "host": "document-service", "port": 8083, "schema": "http"}'
AIRFLOW_CONN_OTTERWORKS_FILE_SERVICE='{"conn_type": "http", "host": "file-service", "port": 8082, "schema": "http"}'

# --- Variables: shared S3 buckets ---
AIRFLOW_VAR_DATA_LAKE_BUCKET=otterworks-data-lake
AIRFLOW_VAR_FILE_STORAGE_BUCKET=otterworks-file-storage
AIRFLOW_VAR_QUARANTINE_BUCKET=otterworks-file-quarantine
AIRFLOW_VAR_ARCHIVE_BUCKET=otterworks-audit-archive

# --- Variables: otterworks_analytics_etl ---
AIRFLOW_VAR_ANALYTICS_PREFIX=analytics/daily
AIRFLOW_VAR_ANALYTICS_REPORT_PREFIX=reports/analytics/daily
AIRFLOW_VAR_ANALYTICS_REPORT_TOP_USERS=5
AIRFLOW_VAR_ANALYTICS_SQS_QUEUE_NAME=otterworks-analytics
AIRFLOW_VAR_ANALYTICS_SQS_MAX_MESSAGES=10000
AIRFLOW_VAR_ANALYTICS_SQS_BATCH_SIZE=10
AIRFLOW_VAR_ANALYTICS_SQS_WAIT_TIME_SECONDS=5
AIRFLOW_VAR_ANALYTICS_SQS_MAX_CONSECUTIVE_ERRORS=3
AIRFLOW_VAR_ANALYTICS_DYNAMODB_TABLE=otterworks-analytics-events

# --- Variables: otterworks_audit_archive ---
AIRFLOW_VAR_AUDIT_ARCHIVE_DYNAMODB_TABLE=otterworks-audit-events
AIRFLOW_VAR_AUDIT_ARCHIVE_RETENTION_DAYS=90
AIRFLOW_VAR_AUDIT_ARCHIVE_S3_PREFIX=audit-archive
AIRFLOW_VAR_AUDIT_ARCHIVE_STORAGE_CLASS=GLACIER
AIRFLOW_VAR_AUDIT_ARCHIVE_REPORT_PREFIX=reports/compliance/audit-archive
AIRFLOW_VAR_AUDIT_ARCHIVE_DELETE_BATCH_SIZE=25
AIRFLOW_VAR_AUDIT_ARCHIVE_DELETE_ENABLED=false

# --- Variables: otterworks_search_reindex ---
AIRFLOW_VAR_SEARCH_REINDEX_DOCUMENTS_INDEX=documents
AIRFLOW_VAR_SEARCH_REINDEX_FILES_INDEX=files
AIRFLOW_VAR_SEARCH_REINDEX_API_PAGE_SIZE=100
AIRFLOW_VAR_SEARCH_REINDEX_BULK_BATCH_SIZE=500
AIRFLOW_VAR_SEARCH_REINDEX_TASK_TIMEOUT_SECONDS=60
AIRFLOW_VAR_SEARCH_REINDEX_BULK_TASK_TIMEOUT_SECONDS=120

# --- Variables: otterworks_storage_cleanup ---
AIRFLOW_VAR_STORAGE_CLEANUP_FILES_PREFIX=files/
AIRFLOW_VAR_STORAGE_CLEANUP_METADATA_TABLE=otterworks-file-metadata
AIRFLOW_VAR_STORAGE_CLEANUP_QUARANTINE_PREFIX=quarantined
AIRFLOW_VAR_STORAGE_CLEANUP_REPORT_PREFIX=reports/storage-cleanup
AIRFLOW_VAR_STORAGE_CLEANUP_PRICE_PER_GB_MONTH_USD=0.023
AIRFLOW_VAR_STORAGE_CLEANUP_NORMALIZE_KEYS=false

# --- Variables: otterworks_user_activity_report ---
AIRFLOW_VAR_USER_ACTIVITY_LOOKBACK_DAYS=30
AIRFLOW_VAR_USER_ACTIVITY_REPORT_PREFIX=reports/user-activity
AIRFLOW_VAR_USER_ACTIVITY_MAX_USER_SUMMARIES=500
AIRFLOW_VAR_USER_ACTIVITY_TOP_USERS=20
