#!/usr/bin/env python3
import argparse
import os
from pathlib import Path
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--area', required=True)
    parser.add_argument('--table', required=True)
    parser.add_argument('--business-date', default='20261109')
    args = parser.parse_args()
    target = 'SFX_' + args.area.upper() + '.' + args.table.upper()
    source = 'SFX_' + args.area.upper() + '.STG_' + args.table.upper()
    statement = (
        '.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};\n'
        'DELETE FROM SFX_AUDIT.AUDIT_RECON WHERE RECON_ID=21000000001;\n'
        '.IF ERRORCODE <> 0 THEN .GOTO failed\n'
        'INSERT INTO SFX_AUDIT.AUDIT_RECON (RECON_ID,BUSINESS_DT,CUSTOMER_ID,SOURCE_COUNT,TARGET_COUNT,DIFFERENCE_COUNT) '
        "SELECT 21000000001,CAST('" + args.business_date + "' AS DATE FORMAT 'YYYYMMDD'),0,s.n,t.n,s.n-t.n "
        'FROM (SELECT COUNT(*) AS n FROM ' + source + ') s, (SELECT COUNT(*) AS n FROM ' + target + ') t;\n'
        '.IF ERRORCODE <> 0 THEN .GOTO failed\n'
        '.QUIT 0\n.LABEL failed\n.QUIT 8\n'
    )
    root = Path(__file__).resolve().parents[1]
    return subprocess.run([sys.executable, '-m', 'bteq'], input=statement, text=True,
                          env={**os.environ, 'PYTHONPATH': str(root)}).returncode


if __name__ == '__main__':
    sys.exit(main())
