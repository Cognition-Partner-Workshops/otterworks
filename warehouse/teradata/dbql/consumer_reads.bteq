.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET SEPARATOR '|'
SELECT UserName, AppID, ClientID, COUNT(*) AS READ_QUERIES,
CAST(COUNT(*) / 30.00 AS DECIMAL(12,2)) AS READS_PER_DAY
FROM DBC.QryLogV
WHERE StartTime >= TIMESTAMP '2026-10-11 00:00:00'
AND StartTime < TIMESTAMP '2026-11-10 00:00:00'
AND StatementType='SELECT' AND ErrorCode=0
GROUP BY UserName, AppID, ClientID
ORDER BY READ_QUERIES DESC, UserName;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
