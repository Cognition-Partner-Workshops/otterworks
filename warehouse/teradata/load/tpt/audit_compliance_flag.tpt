DEFINE JOB audit_compliance_flag
(
  DEFINE SCHEMA RowSchema
  (
    FLAG_ID VARCHAR(200),
    CUSTOMER_ID VARCHAR(200),
    DOCUMENT_ID VARCHAR(200),
    FLAG_TYPE VARCHAR(200),
    FLAG_DT VARCHAR(200),
    STATUS_CD VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/audit/COMPLIANCE_FLAG',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_AUDIT.STG_COMPLIANCE_FLAG',
    VARCHAR LogTable = 'SFX_AUDIT.STG_COMPLIANCE_FLAG_LOG',
    VARCHAR ErrorTable1 = 'SFX_AUDIT.STG_COMPLIANCE_FLAG_ET',
    VARCHAR ErrorTable2 = 'SFX_AUDIT.STG_COMPLIANCE_FLAG_UV'
  );
  APPLY ('INSERT INTO SFX_AUDIT.STG_COMPLIANCE_FLAG (FLAG_ID, CUSTOMER_ID, DOCUMENT_ID, FLAG_TYPE, FLAG_DT, STATUS_CD) VALUES (:FLAG_ID, :CUSTOMER_ID, :DOCUMENT_ID, :FLAG_TYPE, :FLAG_DT, :STATUS_CD);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
