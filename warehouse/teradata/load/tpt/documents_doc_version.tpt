DEFINE JOB documents_doc_version
(
  DEFINE SCHEMA RowSchema
  (
    VERSION_ID VARCHAR(200),
    DOCUMENT_ID VARCHAR(200),
    VERSION_NO VARCHAR(200),
    VERSION_TS VARCHAR(200),
    FILE_SIZE VARCHAR(200),
    CONTENT_HASH VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/documents/DOC_VERSION',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_DOCUMENTS.STG_DOC_VERSION',
    VARCHAR LogTable = 'SFX_DOCUMENTS.STG_DOC_VERSION_LOG',
    VARCHAR ErrorTable1 = 'SFX_DOCUMENTS.STG_DOC_VERSION_ET',
    VARCHAR ErrorTable2 = 'SFX_DOCUMENTS.STG_DOC_VERSION_UV'
  );
  APPLY ('INSERT INTO SFX_DOCUMENTS.STG_DOC_VERSION (VERSION_ID, DOCUMENT_ID, VERSION_NO, VERSION_TS, FILE_SIZE, CONTENT_HASH) VALUES (:VERSION_ID, :DOCUMENT_ID, :VERSION_NO, :VERSION_TS, :FILE_SIZE, :CONTENT_HASH);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
