DEFINE JOB audit_data_export_req
(
  DEFINE SCHEMA RowSchema
  (
    EXPORT_ID VARCHAR(200),
    USER_ID VARCHAR(200),
    CUSTOMER_ID VARCHAR(200),
    REQUEST_DT VARCHAR(200),
    STATUS_CD VARCHAR(200),
    ROW_COUNT VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/audit/DATA_EXPORT_REQ',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_AUDIT.STG_DATA_EXPORT_REQ',
    VARCHAR LogTable = 'SFX_AUDIT.STG_DATA_EXPORT_REQ_LOG',
    VARCHAR ErrorTable1 = 'SFX_AUDIT.STG_DATA_EXPORT_REQ_ET',
    VARCHAR ErrorTable2 = 'SFX_AUDIT.STG_DATA_EXPORT_REQ_UV'
  );
  APPLY ('INSERT INTO SFX_AUDIT.STG_DATA_EXPORT_REQ (EXPORT_ID, USER_ID, CUSTOMER_ID, REQUEST_DT, STATUS_CD, ROW_COUNT) VALUES (:EXPORT_ID, :USER_ID, :CUSTOMER_ID, :REQUEST_DT, :STATUS_CD, :ROW_COUNT);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
