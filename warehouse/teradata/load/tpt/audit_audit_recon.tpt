DEFINE JOB audit_audit_recon
(
  DEFINE SCHEMA RowSchema
  (
    RECON_ID VARCHAR(200),
    BUSINESS_DT VARCHAR(200),
    CUSTOMER_ID VARCHAR(200),
    SOURCE_COUNT VARCHAR(200),
    TARGET_COUNT VARCHAR(200),
    DIFFERENCE_COUNT VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/audit/AUDIT_RECON',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_AUDIT.STG_AUDIT_RECON',
    VARCHAR LogTable = 'SFX_AUDIT.STG_AUDIT_RECON_LOG',
    VARCHAR ErrorTable1 = 'SFX_AUDIT.STG_AUDIT_RECON_ET',
    VARCHAR ErrorTable2 = 'SFX_AUDIT.STG_AUDIT_RECON_UV'
  );
  APPLY ('INSERT INTO SFX_AUDIT.STG_AUDIT_RECON (RECON_ID, BUSINESS_DT, CUSTOMER_ID, SOURCE_COUNT, TARGET_COUNT, DIFFERENCE_COUNT) VALUES (:RECON_ID, :BUSINESS_DT, :CUSTOMER_ID, :SOURCE_COUNT, :TARGET_COUNT, :DIFFERENCE_COUNT);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
