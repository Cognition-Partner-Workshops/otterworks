DEFINE JOB documents_collab_session
(
  DEFINE SCHEMA RowSchema
  (
    SESSION_ID VARCHAR(200),
    DOCUMENT_ID VARCHAR(200),
    USER_ID VARCHAR(200),
    START_TS VARCHAR(200),
    END_TS VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/documents/COLLAB_SESSION',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_DOCUMENTS.STG_COLLAB_SESSION',
    VARCHAR LogTable = 'SFX_DOCUMENTS.STG_COLLAB_SESSION_LOG',
    VARCHAR ErrorTable1 = 'SFX_DOCUMENTS.STG_COLLAB_SESSION_ET',
    VARCHAR ErrorTable2 = 'SFX_DOCUMENTS.STG_COLLAB_SESSION_UV'
  );
  APPLY ('INSERT INTO SFX_DOCUMENTS.STG_COLLAB_SESSION (SESSION_ID, DOCUMENT_ID, USER_ID, START_TS, END_TS) VALUES (:SESSION_ID, :DOCUMENT_ID, :USER_ID, :START_TS, :END_TS);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
