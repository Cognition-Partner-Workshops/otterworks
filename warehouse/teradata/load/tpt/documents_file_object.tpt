DEFINE JOB documents_file_object
(
  DEFINE SCHEMA RowSchema
  (
    FILE_OBJECT_ID VARCHAR(200),
    DOCUMENT_ID VARCHAR(200),
    OBJECT_KEY VARCHAR(200),
    BYTES_USED VARCHAR(200),
    STORAGE_CLASS VARCHAR(200),
    CREATED_DT VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/documents/FILE_OBJECT',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_DOCUMENTS.STG_FILE_OBJECT',
    VARCHAR LogTable = 'SFX_DOCUMENTS.STG_FILE_OBJECT_LOG',
    VARCHAR ErrorTable1 = 'SFX_DOCUMENTS.STG_FILE_OBJECT_ET',
    VARCHAR ErrorTable2 = 'SFX_DOCUMENTS.STG_FILE_OBJECT_UV'
  );
  APPLY ('INSERT INTO SFX_DOCUMENTS.STG_FILE_OBJECT (FILE_OBJECT_ID, DOCUMENT_ID, OBJECT_KEY, BYTES_USED, STORAGE_CLASS, CREATED_DT) VALUES (:FILE_OBJECT_ID, :DOCUMENT_ID, :OBJECT_KEY, :BYTES_USED, :STORAGE_CLASS, :CREATED_DT);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
