DEFINE JOB documents_doc_share
(
  DEFINE SCHEMA RowSchema
  (
    SHARE_ID VARCHAR(200),
    DOCUMENT_ID VARCHAR(200),
    USER_ID VARCHAR(200),
    ACCESS_LEVEL VARCHAR(200),
    SHARED_DT VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/documents/DOC_SHARE',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_DOCUMENTS.STG_DOC_SHARE',
    VARCHAR LogTable = 'SFX_DOCUMENTS.STG_DOC_SHARE_LOG',
    VARCHAR ErrorTable1 = 'SFX_DOCUMENTS.STG_DOC_SHARE_ET',
    VARCHAR ErrorTable2 = 'SFX_DOCUMENTS.STG_DOC_SHARE_UV'
  );
  APPLY ('INSERT INTO SFX_DOCUMENTS.STG_DOC_SHARE (SHARE_ID, DOCUMENT_ID, USER_ID, ACCESS_LEVEL, SHARED_DT) VALUES (:SHARE_ID, :DOCUMENT_ID, :USER_ID, :ACCESS_LEVEL, :SHARED_DT);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
