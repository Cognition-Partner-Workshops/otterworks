DEFINE JOB audit_access_review
(
  DEFINE SCHEMA RowSchema
  (
    REVIEW_ID VARCHAR(200),
    USER_ID VARCHAR(200),
    DOCUMENT_ID VARCHAR(200),
    REVIEW_DT VARCHAR(200),
    DECISION_CD VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/audit/ACCESS_REVIEW',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_AUDIT.STG_ACCESS_REVIEW',
    VARCHAR LogTable = 'SFX_AUDIT.STG_ACCESS_REVIEW_LOG',
    VARCHAR ErrorTable1 = 'SFX_AUDIT.STG_ACCESS_REVIEW_ET',
    VARCHAR ErrorTable2 = 'SFX_AUDIT.STG_ACCESS_REVIEW_UV'
  );
  APPLY ('INSERT INTO SFX_AUDIT.STG_ACCESS_REVIEW (REVIEW_ID, USER_ID, DOCUMENT_ID, REVIEW_DT, DECISION_CD) VALUES (:REVIEW_ID, :USER_ID, :DOCUMENT_ID, :REVIEW_DT, :DECISION_CD);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
