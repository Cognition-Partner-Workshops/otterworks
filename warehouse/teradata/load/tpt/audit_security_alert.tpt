DEFINE JOB audit_security_alert
(
  DEFINE SCHEMA RowSchema
  (
    ALERT_ID VARCHAR(200),
    ACTOR_USER_ID VARCHAR(200),
    DOCUMENT_ID VARCHAR(200),
    ALERT_TS VARCHAR(200),
    SEVERITY_CD VARCHAR(200),
    STATUS_CD VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/audit/SECURITY_ALERT',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_AUDIT.STG_SECURITY_ALERT',
    VARCHAR LogTable = 'SFX_AUDIT.STG_SECURITY_ALERT_LOG',
    VARCHAR ErrorTable1 = 'SFX_AUDIT.STG_SECURITY_ALERT_ET',
    VARCHAR ErrorTable2 = 'SFX_AUDIT.STG_SECURITY_ALERT_UV'
  );
  APPLY ('INSERT INTO SFX_AUDIT.STG_SECURITY_ALERT (ALERT_ID, ACTOR_USER_ID, DOCUMENT_ID, ALERT_TS, SEVERITY_CD, STATUS_CD) VALUES (:ALERT_ID, :ACTOR_USER_ID, :DOCUMENT_ID, :ALERT_TS, :SEVERITY_CD, :STATUS_CD);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
