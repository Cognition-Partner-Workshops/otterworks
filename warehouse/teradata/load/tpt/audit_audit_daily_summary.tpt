DEFINE JOB audit_audit_daily_summary
(
  DEFINE SCHEMA RowSchema
  (
    SUMMARY_ID VARCHAR(200),
    SUMMARY_DT VARCHAR(200),
    CUSTOMER_ID VARCHAR(200),
    EVENT_COUNT VARCHAR(200),
    EXPORT_COUNT VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/audit/AUDIT_DAILY_SUMMARY',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_AUDIT.STG_AUDIT_DAILY_SUMMARY',
    VARCHAR LogTable = 'SFX_AUDIT.STG_AUDIT_DAILY_SUMMARY_LOG',
    VARCHAR ErrorTable1 = 'SFX_AUDIT.STG_AUDIT_DAILY_SUMMARY_ET',
    VARCHAR ErrorTable2 = 'SFX_AUDIT.STG_AUDIT_DAILY_SUMMARY_UV'
  );
  APPLY ('INSERT INTO SFX_AUDIT.STG_AUDIT_DAILY_SUMMARY (SUMMARY_ID, SUMMARY_DT, CUSTOMER_ID, EVENT_COUNT, EXPORT_COUNT) VALUES (:SUMMARY_ID, :SUMMARY_DT, :CUSTOMER_ID, :EVENT_COUNT, :EXPORT_COUNT);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
