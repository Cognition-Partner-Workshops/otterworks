DEFINE JOB documents_storage_usage_daily
(
  DEFINE SCHEMA RowSchema
  (
    STORAGE_USAGE_ID VARCHAR(200),
    CUSTOMER_ID VARCHAR(200),
    OWNER_USER_ID VARCHAR(200),
    USAGE_DT VARCHAR(200),
    BYTES_USED VARCHAR(200),
    OBJECT_COUNT VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/documents/STORAGE_USAGE_DAILY',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_DOCUMENTS.STG_STORAGE_USAGE_DAILY',
    VARCHAR LogTable = 'SFX_DOCUMENTS.STG_STORAGE_USAGE_DAILY_LOG',
    VARCHAR ErrorTable1 = 'SFX_DOCUMENTS.STG_STORAGE_USAGE_DAILY_ET',
    VARCHAR ErrorTable2 = 'SFX_DOCUMENTS.STG_STORAGE_USAGE_DAILY_UV'
  );
  APPLY ('INSERT INTO SFX_DOCUMENTS.STG_STORAGE_USAGE_DAILY (STORAGE_USAGE_ID, CUSTOMER_ID, OWNER_USER_ID, USAGE_DT, BYTES_USED, OBJECT_COUNT) VALUES (:STORAGE_USAGE_ID, :CUSTOMER_ID, :OWNER_USER_ID, :USAGE_DT, :BYTES_USED, :OBJECT_COUNT);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
