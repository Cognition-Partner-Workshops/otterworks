DEFINE JOB audit_legal_hold
(
  DEFINE SCHEMA RowSchema
  (
    HOLD_ID VARCHAR(200),
    DOCUMENT_ID VARCHAR(200),
    CUSTOMER_ID VARCHAR(200),
    START_DT VARCHAR(200),
    REASON_TEXT VARCHAR(200),
    STATUS_CD VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/audit/LEGAL_HOLD',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_AUDIT.STG_LEGAL_HOLD',
    VARCHAR LogTable = 'SFX_AUDIT.STG_LEGAL_HOLD_LOG',
    VARCHAR ErrorTable1 = 'SFX_AUDIT.STG_LEGAL_HOLD_ET',
    VARCHAR ErrorTable2 = 'SFX_AUDIT.STG_LEGAL_HOLD_UV'
  );
  APPLY ('INSERT INTO SFX_AUDIT.STG_LEGAL_HOLD (HOLD_ID, DOCUMENT_ID, CUSTOMER_ID, START_DT, REASON_TEXT, STATUS_CD) VALUES (:HOLD_ID, :DOCUMENT_ID, :CUSTOMER_ID, :START_DT, :REASON_TEXT, :STATUS_CD);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
