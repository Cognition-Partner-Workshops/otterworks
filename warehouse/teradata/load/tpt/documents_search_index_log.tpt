DEFINE JOB documents_search_index_log
(
  DEFINE SCHEMA RowSchema
  (
    INDEX_LOG_ID VARCHAR(200),
    DOCUMENT_ID VARCHAR(200),
    INDEXED_TS VARCHAR(200),
    STATUS_CD VARCHAR(200),
    TOKEN_COUNT VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/documents/SEARCH_INDEX_LOG',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_DOCUMENTS.STG_SEARCH_INDEX_LOG',
    VARCHAR LogTable = 'SFX_DOCUMENTS.STG_SEARCH_INDEX_LOG_LOG',
    VARCHAR ErrorTable1 = 'SFX_DOCUMENTS.STG_SEARCH_INDEX_LOG_ET',
    VARCHAR ErrorTable2 = 'SFX_DOCUMENTS.STG_SEARCH_INDEX_LOG_UV'
  );
  APPLY ('INSERT INTO SFX_DOCUMENTS.STG_SEARCH_INDEX_LOG (INDEX_LOG_ID, DOCUMENT_ID, INDEXED_TS, STATUS_CD, TOKEN_COUNT) VALUES (:INDEX_LOG_ID, :DOCUMENT_ID, :INDEXED_TS, :STATUS_CD, :TOKEN_COUNT);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
