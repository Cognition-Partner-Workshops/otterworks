DEFINE JOB documents_folder
(
  DEFINE SCHEMA RowSchema
  (
    FOLDER_ID VARCHAR(200),
    OWNER_USER_ID VARCHAR(200),
    CUSTOMER_ID VARCHAR(200),
    FOLDER_NAME VARCHAR(200),
    CREATED_DT VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/documents/FOLDER',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_DOCUMENTS.STG_FOLDER',
    VARCHAR LogTable = 'SFX_DOCUMENTS.STG_FOLDER_LOG',
    VARCHAR ErrorTable1 = 'SFX_DOCUMENTS.STG_FOLDER_ET',
    VARCHAR ErrorTable2 = 'SFX_DOCUMENTS.STG_FOLDER_UV'
  );
  APPLY ('INSERT INTO SFX_DOCUMENTS.STG_FOLDER (FOLDER_ID, OWNER_USER_ID, CUSTOMER_ID, FOLDER_NAME, CREATED_DT) VALUES (:FOLDER_ID, :OWNER_USER_ID, :CUSTOMER_ID, :FOLDER_NAME, :CREATED_DT);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
