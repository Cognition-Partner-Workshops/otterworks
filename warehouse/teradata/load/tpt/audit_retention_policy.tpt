DEFINE JOB audit_retention_policy
(
  DEFINE SCHEMA RowSchema
  (
    POLICY_ID VARCHAR(200),
    POLICY_NAME VARCHAR(200),
    RETENTION_DAYS VARCHAR(200),
    EFFECTIVE_DT VARCHAR(200),
    STATUS_CD VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/audit/RETENTION_POLICY',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_AUDIT.STG_RETENTION_POLICY',
    VARCHAR LogTable = 'SFX_AUDIT.STG_RETENTION_POLICY_LOG',
    VARCHAR ErrorTable1 = 'SFX_AUDIT.STG_RETENTION_POLICY_ET',
    VARCHAR ErrorTable2 = 'SFX_AUDIT.STG_RETENTION_POLICY_UV'
  );
  APPLY ('INSERT INTO SFX_AUDIT.STG_RETENTION_POLICY (POLICY_ID, POLICY_NAME, RETENTION_DAYS, EFFECTIVE_DT, STATUS_CD) VALUES (:POLICY_ID, :POLICY_NAME, :RETENTION_DAYS, :EFFECTIVE_DT, :STATUS_CD);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
