DEFINE JOB documents_doc_comment
(
  DEFINE SCHEMA RowSchema
  (
    COMMENT_ID VARCHAR(200),
    DOCUMENT_ID VARCHAR(200),
    USER_ID VARCHAR(200),
    COMMENT_TEXT VARCHAR(200),
    CREATED_TS VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/documents/DOC_COMMENT',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_DOCUMENTS.STG_DOC_COMMENT',
    VARCHAR LogTable = 'SFX_DOCUMENTS.STG_DOC_COMMENT_LOG',
    VARCHAR ErrorTable1 = 'SFX_DOCUMENTS.STG_DOC_COMMENT_ET',
    VARCHAR ErrorTable2 = 'SFX_DOCUMENTS.STG_DOC_COMMENT_UV'
  );
  APPLY ('INSERT INTO SFX_DOCUMENTS.STG_DOC_COMMENT (COMMENT_ID, DOCUMENT_ID, USER_ID, COMMENT_TEXT, CREATED_TS) VALUES (:COMMENT_ID, :DOCUMENT_ID, :USER_ID, :COMMENT_TEXT, :CREATED_TS);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
