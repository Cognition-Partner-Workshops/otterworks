DEFINE JOB audit_audit_event
(
  DEFINE SCHEMA RowSchema
  (
    EVENT_ID VARCHAR(200),
    ACTOR_USER_ID VARCHAR(200),
    DOCUMENT_ID VARCHAR(200),
    CUSTOMER_ID VARCHAR(200),
    EVENT_TS VARCHAR(200),
    EVENT_TYPE VARCHAR(200),
    DETAILS VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/audit/AUDIT_EVENT',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_AUDIT.STG_AUDIT_EVENT',
    VARCHAR LogTable = 'SFX_AUDIT.STG_AUDIT_EVENT_LOG',
    VARCHAR ErrorTable1 = 'SFX_AUDIT.STG_AUDIT_EVENT_ET',
    VARCHAR ErrorTable2 = 'SFX_AUDIT.STG_AUDIT_EVENT_UV'
  );
  APPLY ('INSERT INTO SFX_AUDIT.STG_AUDIT_EVENT (EVENT_ID, ACTOR_USER_ID, DOCUMENT_ID, CUSTOMER_ID, EVENT_TS, EVENT_TYPE, DETAILS) VALUES (:EVENT_ID, :ACTOR_USER_ID, :DOCUMENT_ID, :CUSTOMER_ID, :EVENT_TS, :EVENT_TYPE, :DETAILS);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
