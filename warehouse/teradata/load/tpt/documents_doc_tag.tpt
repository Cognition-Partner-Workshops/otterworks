DEFINE JOB documents_doc_tag
(
  DEFINE SCHEMA RowSchema
  (
    TAG_ID VARCHAR(200),
    DOCUMENT_ID VARCHAR(200),
    TAG_NAME VARCHAR(200),
    CREATED_DT VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/documents/DOC_TAG',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_DOCUMENTS.STG_DOC_TAG',
    VARCHAR LogTable = 'SFX_DOCUMENTS.STG_DOC_TAG_LOG',
    VARCHAR ErrorTable1 = 'SFX_DOCUMENTS.STG_DOC_TAG_ET',
    VARCHAR ErrorTable2 = 'SFX_DOCUMENTS.STG_DOC_TAG_UV'
  );
  APPLY ('INSERT INTO SFX_DOCUMENTS.STG_DOC_TAG (TAG_ID, DOCUMENT_ID, TAG_NAME, CREATED_DT) VALUES (:TAG_ID, :DOCUMENT_ID, :TAG_NAME, :CREATED_DT);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
