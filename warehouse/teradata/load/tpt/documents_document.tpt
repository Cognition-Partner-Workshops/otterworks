DEFINE JOB documents_document
(
  DEFINE SCHEMA RowSchema
  (
    DOCUMENT_ID VARCHAR(200),
    FOLDER_ID VARCHAR(200),
    OWNER_USER_ID VARCHAR(200),
    CUSTOMER_ID VARCHAR(200),
    DOCUMENT_NAME VARCHAR(200),
    CREATED_DT VARCHAR(200),
    STATUS_CD VARCHAR(200),
    FILE_TYPE VARCHAR(200)
  );
  DEFINE OPERATOR InputFile
  TYPE DATACONNECTOR PRODUCER
  SCHEMA RowSchema
  ATTRIBUTES
  (
    VARCHAR DirectoryPath = '${LANDING_DIR}/documents/DOCUMENT',
    VARCHAR FileName = '${BUSINESS_DATE}.psv',
    VARCHAR Format = 'Delimited',
    VARCHAR TextDelimiter = '|'
  );
  DEFINE OPERATOR StageLoad
  TYPE LOAD
  SCHEMA *
  ATTRIBUTES
  (
    VARCHAR TdpId = '${TD_HOST}',
    VARCHAR UserName = '${TD_USER}',
    VARCHAR UserPassword = '${TD_PASSWORD}',
    VARCHAR TargetTable = 'SFX_DOCUMENTS.STG_DOCUMENT',
    VARCHAR LogTable = 'SFX_DOCUMENTS.STG_DOCUMENT_LOG',
    VARCHAR ErrorTable1 = 'SFX_DOCUMENTS.STG_DOCUMENT_ET',
    VARCHAR ErrorTable2 = 'SFX_DOCUMENTS.STG_DOCUMENT_UV'
  );
  APPLY ('INSERT INTO SFX_DOCUMENTS.STG_DOCUMENT (DOCUMENT_ID, FOLDER_ID, OWNER_USER_ID, CUSTOMER_ID, DOCUMENT_NAME, CREATED_DT, STATUS_CD, FILE_TYPE) VALUES (:DOCUMENT_ID, :FOLDER_ID, :OWNER_USER_ID, :CUSTOMER_ID, :DOCUMENT_NAME, :CREATED_DT, :STATUS_CD, :FILE_TYPE);')
  TO OPERATOR (StageLoad[1])
  SELECT * FROM OPERATOR (InputFile[1]);
);
