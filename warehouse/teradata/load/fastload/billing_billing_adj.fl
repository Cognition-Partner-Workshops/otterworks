SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    ADJUSTMENT_ID (VARCHAR(200)),
    CUSTOMER_ID (VARCHAR(200)),
    INVOICE_ID (VARCHAR(200)),
    ADJUSTMENT_DT (VARCHAR(200)),
    AMOUNT (VARCHAR(200)),
    REASON_CD (VARCHAR(200))
FILE=${LANDING_DIR}/billing/BILLING_ADJ/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_BILLING.STG_BILLING_ADJ ERRORFILES SFX_BILLING.STG_BILLING_ADJ_ET, SFX_BILLING.STG_BILLING_ADJ_UV;
INSERT INTO SFX_BILLING.STG_BILLING_ADJ (ADJUSTMENT_ID, CUSTOMER_ID, INVOICE_ID, ADJUSTMENT_DT, AMOUNT, REASON_CD) VALUES (:ADJUSTMENT_ID, :CUSTOMER_ID, :INVOICE_ID, :ADJUSTMENT_DT, :AMOUNT, :REASON_CD);
END LOADING;
.LOGOFF;
