SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    USER_ID (VARCHAR(200)),
    DISPLAY_NAME (VARCHAR(200)),
    EMAIL (VARCHAR(200)),
    STATUS_CD (VARCHAR(200)),
    CREATED_DT (VARCHAR(200))
FILE=${LANDING_DIR}/users/APP_USER/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_USERS.STG_APP_USER ERRORFILES SFX_USERS.STG_APP_USER_ET, SFX_USERS.STG_APP_USER_UV;
INSERT INTO SFX_USERS.STG_APP_USER (USER_ID, DISPLAY_NAME, EMAIL, STATUS_CD, CREATED_DT) VALUES (:USER_ID, :DISPLAY_NAME, :EMAIL, :STATUS_CD, :CREATED_DT);
END LOADING;
.LOGOFF;
