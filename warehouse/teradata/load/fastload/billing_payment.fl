SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    PAYMENT_ID (VARCHAR(200)),
    INVOICE_ID (VARCHAR(200)),
    CUSTOMER_ID (VARCHAR(200)),
    PAYMENT_DT (VARCHAR(200)),
    AMOUNT (VARCHAR(200)),
    METHOD_CD (VARCHAR(200)),
    PAYMENT_REFERENCE (VARCHAR(200))
FILE=${LANDING_DIR}/billing/PAYMENT/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_BILLING.STG_PAYMENT ERRORFILES SFX_BILLING.STG_PAYMENT_ET, SFX_BILLING.STG_PAYMENT_UV;
INSERT INTO SFX_BILLING.STG_PAYMENT (PAYMENT_ID, INVOICE_ID, CUSTOMER_ID, PAYMENT_DT, AMOUNT, METHOD_CD, PAYMENT_REFERENCE) VALUES (:PAYMENT_ID, :INVOICE_ID, :CUSTOMER_ID, :PAYMENT_DT, :AMOUNT, :METHOD_CD, :PAYMENT_REFERENCE);
END LOADING;
.LOGOFF;
