SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    USAGE_ID (VARCHAR(200)),
    CUSTOMER_ID (VARCHAR(200)),
    SUBSCRIPTION_ID (VARCHAR(200)),
    USAGE_DT (VARCHAR(200)),
    UNITS (VARCHAR(200)),
    USAGE_TYPE (VARCHAR(200))
FILE=${LANDING_DIR}/billing/USAGE_DAILY/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_BILLING.STG_USAGE_DAILY ERRORFILES SFX_BILLING.STG_USAGE_DAILY_ET, SFX_BILLING.STG_USAGE_DAILY_UV;
INSERT INTO SFX_BILLING.STG_USAGE_DAILY (USAGE_ID, CUSTOMER_ID, SUBSCRIPTION_ID, USAGE_DT, UNITS, USAGE_TYPE) VALUES (:USAGE_ID, :CUSTOMER_ID, :SUBSCRIPTION_ID, :USAGE_DT, :UNITS, :USAGE_TYPE);
END LOADING;
.LOGOFF;
