SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    PROFILE_ID (VARCHAR(200)),
    USER_ID (VARCHAR(200)),
    TITLE (VARCHAR(200)),
    COUNTRY_CD (VARCHAR(200)),
    TIMEZONE (VARCHAR(200))
FILE=${LANDING_DIR}/users/USER_PROFILE/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_USERS.STG_USER_PROFILE ERRORFILES SFX_USERS.STG_USER_PROFILE_ET, SFX_USERS.STG_USER_PROFILE_UV;
INSERT INTO SFX_USERS.STG_USER_PROFILE (PROFILE_ID, USER_ID, TITLE, COUNTRY_CD, TIMEZONE) VALUES (:PROFILE_ID, :USER_ID, :TITLE, :COUNTRY_CD, :TIMEZONE);
END LOADING;
.LOGOFF;
