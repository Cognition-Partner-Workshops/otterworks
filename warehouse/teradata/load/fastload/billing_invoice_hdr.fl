SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    INVOICE_ID (VARCHAR(200)),
    CUSTOMER_ID (VARCHAR(200)),
    SUBSCRIPTION_ID (VARCHAR(200)),
    INVOICE_DT (VARCHAR(200)),
    BILL_DT (VARCHAR(200)),
    PERIOD_START_DT (VARCHAR(200)),
    CURRENCY_CD (VARCHAR(200)),
    TOTAL_AMOUNT (VARCHAR(200)),
    INVOICE_NUMBER (VARCHAR(200)),
    TAX_RATE_ID (VARCHAR(200)),
    SUBTOTAL_AMOUNT (VARCHAR(200)),
    TAX_AMOUNT (VARCHAR(200)),
    INVOICE_PERIOD (VARCHAR(200)),
    PERIOD_KEY (VARCHAR(200)),
    PRIOR_PERIOD_END_DT (VARCHAR(200)),
    INVOICE_MONTH (VARCHAR(200)),
    PERIOD_CLOSED_CD (VARCHAR(200)),
    CURRENCY_CONTROL_TOTAL (VARCHAR(200))
FILE=${LANDING_DIR}/billing/INVOICE_HDR/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_BILLING.STG_INVOICE_HDR ERRORFILES SFX_BILLING.STG_INVOICE_HDR_ET, SFX_BILLING.STG_INVOICE_HDR_UV;
INSERT INTO SFX_BILLING.STG_INVOICE_HDR (INVOICE_ID, CUSTOMER_ID, SUBSCRIPTION_ID, INVOICE_DT, BILL_DT, PERIOD_START_DT, CURRENCY_CD, TOTAL_AMOUNT, INVOICE_NUMBER, TAX_RATE_ID, SUBTOTAL_AMOUNT, TAX_AMOUNT, INVOICE_PERIOD, PERIOD_KEY, PRIOR_PERIOD_END_DT, INVOICE_MONTH, PERIOD_CLOSED_CD, CURRENCY_CONTROL_TOTAL) VALUES (:INVOICE_ID, :CUSTOMER_ID, :SUBSCRIPTION_ID, :INVOICE_DT, :BILL_DT, :PERIOD_START_DT, :CURRENCY_CD, :TOTAL_AMOUNT, :INVOICE_NUMBER, :TAX_RATE_ID, :SUBTOTAL_AMOUNT, :TAX_AMOUNT, :INVOICE_PERIOD, :PERIOD_KEY, :PRIOR_PERIOD_END_DT, :INVOICE_MONTH, :PERIOD_CLOSED_CD, :CURRENCY_CONTROL_TOTAL);
END LOADING;
.LOGOFF;
