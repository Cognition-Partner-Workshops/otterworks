SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    CUSTOMER_ID (VARCHAR(200)),
    OWNER_USER_ID (VARCHAR(200)),
    ACCOUNT_NAME (VARCHAR(200)),
    STATUS_CD (VARCHAR(200)),
    CURRENCY_CD (VARCHAR(200)),
    CREATED_DT (VARCHAR(200))
FILE=${LANDING_DIR}/billing/CUSTOMER_ACCOUNT/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_BILLING.STG_CUSTOMER_ACCOUNT ERRORFILES SFX_BILLING.STG_CUSTOMER_ACCOUNT_ET, SFX_BILLING.STG_CUSTOMER_ACCOUNT_UV;
INSERT INTO SFX_BILLING.STG_CUSTOMER_ACCOUNT (CUSTOMER_ID, OWNER_USER_ID, ACCOUNT_NAME, STATUS_CD, CURRENCY_CD, CREATED_DT) VALUES (:CUSTOMER_ID, :OWNER_USER_ID, :ACCOUNT_NAME, :STATUS_CD, :CURRENCY_CD, :CREATED_DT);
END LOADING;
.LOGOFF;
