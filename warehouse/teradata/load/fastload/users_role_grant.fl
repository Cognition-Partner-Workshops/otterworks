SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    GRANT_ID (VARCHAR(200)),
    USER_ID (VARCHAR(200)),
    ROLE_CD (VARCHAR(200)),
    GRANTED_DT (VARCHAR(200))
FILE=${LANDING_DIR}/users/ROLE_GRANT/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_USERS.STG_ROLE_GRANT ERRORFILES SFX_USERS.STG_ROLE_GRANT_ET, SFX_USERS.STG_ROLE_GRANT_UV;
INSERT INTO SFX_USERS.STG_ROLE_GRANT (GRANT_ID, USER_ID, ROLE_CD, GRANTED_DT) VALUES (:GRANT_ID, :USER_ID, :ROLE_CD, :GRANTED_DT);
END LOADING;
.LOGOFF;
