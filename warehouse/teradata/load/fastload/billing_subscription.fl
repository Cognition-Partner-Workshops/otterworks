SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    SUBSCRIPTION_ID (VARCHAR(200)),
    CUSTOMER_ID (VARCHAR(200)),
    PLAN_CODE (VARCHAR(200)),
    START_DT (VARCHAR(200)),
    END_DT (VARCHAR(200)),
    STATUS_CD (VARCHAR(200))
FILE=${LANDING_DIR}/billing/SUBSCRIPTION/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_BILLING.STG_SUBSCRIPTION ERRORFILES SFX_BILLING.STG_SUBSCRIPTION_ET, SFX_BILLING.STG_SUBSCRIPTION_UV;
INSERT INTO SFX_BILLING.STG_SUBSCRIPTION (SUBSCRIPTION_ID, CUSTOMER_ID, PLAN_CODE, START_DT, END_DT, STATUS_CD) VALUES (:SUBSCRIPTION_ID, :CUSTOMER_ID, :PLAN_CODE, :START_DT, :END_DT, :STATUS_CD);
END LOADING;
.LOGOFF;
