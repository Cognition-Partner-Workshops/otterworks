SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    ACTIVITY_ID (VARCHAR(200)),
    USER_ID (VARCHAR(200)),
    ACTIVITY_DT (VARCHAR(200)),
    LOGIN_COUNT (VARCHAR(200)),
    DOCUMENT_COUNT (VARCHAR(200))
FILE=${LANDING_DIR}/users/USER_ACTIVITY_DAILY/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_USERS.STG_USER_ACTIVITY_DAILY ERRORFILES SFX_USERS.STG_USER_ACTIVITY_DAILY_ET, SFX_USERS.STG_USER_ACTIVITY_DAILY_UV;
INSERT INTO SFX_USERS.STG_USER_ACTIVITY_DAILY (ACTIVITY_ID, USER_ID, ACTIVITY_DT, LOGIN_COUNT, DOCUMENT_COUNT) VALUES (:ACTIVITY_ID, :USER_ID, :ACTIVITY_DT, :LOGIN_COUNT, :DOCUMENT_COUNT);
END LOADING;
.LOGOFF;
