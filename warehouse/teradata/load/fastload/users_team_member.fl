SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    TEAM_MEMBER_ID (VARCHAR(200)),
    TEAM_ID (VARCHAR(200)),
    USER_ID (VARCHAR(200)),
    ROLE_CD (VARCHAR(200)),
    JOINED_DT (VARCHAR(200))
FILE=${LANDING_DIR}/users/TEAM_MEMBER/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_USERS.STG_TEAM_MEMBER ERRORFILES SFX_USERS.STG_TEAM_MEMBER_ET, SFX_USERS.STG_TEAM_MEMBER_UV;
INSERT INTO SFX_USERS.STG_TEAM_MEMBER (TEAM_MEMBER_ID, TEAM_ID, USER_ID, ROLE_CD, JOINED_DT) VALUES (:TEAM_MEMBER_ID, :TEAM_ID, :USER_ID, :ROLE_CD, :JOINED_DT);
END LOADING;
.LOGOFF;
