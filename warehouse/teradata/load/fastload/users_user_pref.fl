SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    PREF_ID (VARCHAR(200)),
    USER_ID (VARCHAR(200)),
    PREF_NAME (VARCHAR(200)),
    PREF_VALUE (VARCHAR(200)),
    UPDATED_DT (VARCHAR(200))
FILE=${LANDING_DIR}/users/USER_PREF/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_USERS.STG_USER_PREF ERRORFILES SFX_USERS.STG_USER_PREF_ET, SFX_USERS.STG_USER_PREF_UV;
INSERT INTO SFX_USERS.STG_USER_PREF (PREF_ID, USER_ID, PREF_NAME, PREF_VALUE, UPDATED_DT) VALUES (:PREF_ID, :USER_ID, :PREF_NAME, :PREF_VALUE, :UPDATED_DT);
END LOADING;
.LOGOFF;
