SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    LOGIN_ID (VARCHAR(200)),
    USER_ID (VARCHAR(200)),
    LOGIN_TS (VARCHAR(200)),
    RESULT_CD (VARCHAR(200)),
    CLIENT_TYPE (VARCHAR(200))
FILE=${LANDING_DIR}/users/LOGIN_EVENT/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_USERS.STG_LOGIN_EVENT ERRORFILES SFX_USERS.STG_LOGIN_EVENT_ET, SFX_USERS.STG_LOGIN_EVENT_UV;
INSERT INTO SFX_USERS.STG_LOGIN_EVENT (LOGIN_ID, USER_ID, LOGIN_TS, RESULT_CD, CLIENT_TYPE) VALUES (:LOGIN_ID, :USER_ID, :LOGIN_TS, :RESULT_CD, :CLIENT_TYPE);
END LOADING;
.LOGOFF;
