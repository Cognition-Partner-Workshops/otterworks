SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    PLAN_ID (VARCHAR(200)),
    PLAN_CODE (VARCHAR(200)),
    PLAN_NAME (VARCHAR(200)),
    MONTHLY_FEE (VARCHAR(200)),
    CURRENCY_CD (VARCHAR(200))
FILE=${LANDING_DIR}/billing/PLAN_CATALOG/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_BILLING.STG_PLAN_CATALOG ERRORFILES SFX_BILLING.STG_PLAN_CATALOG_ET, SFX_BILLING.STG_PLAN_CATALOG_UV;
INSERT INTO SFX_BILLING.STG_PLAN_CATALOG (PLAN_ID, PLAN_CODE, PLAN_NAME, MONTHLY_FEE, CURRENCY_CD) VALUES (:PLAN_ID, :PLAN_CODE, :PLAN_NAME, :MONTHLY_FEE, :CURRENCY_CD);
END LOADING;
.LOGOFF;
