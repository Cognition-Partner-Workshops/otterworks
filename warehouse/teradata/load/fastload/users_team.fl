SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    TEAM_ID (VARCHAR(200)),
    OWNER_USER_ID (VARCHAR(200)),
    TEAM_NAME (VARCHAR(200)),
    CREATED_DT (VARCHAR(200))
FILE=${LANDING_DIR}/users/TEAM/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_USERS.STG_TEAM ERRORFILES SFX_USERS.STG_TEAM_ET, SFX_USERS.STG_TEAM_UV;
INSERT INTO SFX_USERS.STG_TEAM (TEAM_ID, OWNER_USER_ID, TEAM_NAME, CREATED_DT) VALUES (:TEAM_ID, :OWNER_USER_ID, :TEAM_NAME, :CREATED_DT);
END LOADING;
.LOGOFF;
