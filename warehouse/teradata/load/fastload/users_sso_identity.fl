SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    IDENTITY_ID (VARCHAR(200)),
    USER_ID (VARCHAR(200)),
    PROVIDER_CD (VARCHAR(200)),
    SUBJECT_ID (VARCHAR(200)),
    CREATED_DT (VARCHAR(200))
FILE=${LANDING_DIR}/users/SSO_IDENTITY/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_USERS.STG_SSO_IDENTITY ERRORFILES SFX_USERS.STG_SSO_IDENTITY_ET, SFX_USERS.STG_SSO_IDENTITY_UV;
INSERT INTO SFX_USERS.STG_SSO_IDENTITY (IDENTITY_ID, USER_ID, PROVIDER_CD, SUBJECT_ID, CREATED_DT) VALUES (:IDENTITY_ID, :USER_ID, :PROVIDER_CD, :SUBJECT_ID, :CREATED_DT);
END LOADING;
.LOGOFF;
