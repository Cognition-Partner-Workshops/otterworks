SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    JOURNAL_LINE_ID (VARCHAR(200)),
    INVOICE_ID (VARCHAR(200)),
    CREDIT_NOTE_ID (VARCHAR(200)),
    GL_ACCOUNT_ID (VARCHAR(200)),
    POSTING_DT (VARCHAR(200)),
    CURRENCY_CD (VARCHAR(200)),
    DEBIT_AMOUNT (VARCHAR(200)),
    CREDIT_AMOUNT (VARCHAR(200)),
    DESCRIPTION (VARCHAR(200))
FILE=${LANDING_DIR}/billing/GL_JOURNAL_LINE/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_BILLING.STG_GL_JOURNAL_LINE ERRORFILES SFX_BILLING.STG_GL_JOURNAL_LINE_ET, SFX_BILLING.STG_GL_JOURNAL_LINE_UV;
INSERT INTO SFX_BILLING.STG_GL_JOURNAL_LINE (JOURNAL_LINE_ID, INVOICE_ID, CREDIT_NOTE_ID, GL_ACCOUNT_ID, POSTING_DT, CURRENCY_CD, DEBIT_AMOUNT, CREDIT_AMOUNT, DESCRIPTION) VALUES (:JOURNAL_LINE_ID, :INVOICE_ID, :CREDIT_NOTE_ID, :GL_ACCOUNT_ID, :POSTING_DT, :CURRENCY_CD, :DEBIT_AMOUNT, :CREDIT_AMOUNT, :DESCRIPTION);
END LOADING;
.LOGOFF;
