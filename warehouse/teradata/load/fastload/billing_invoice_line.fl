SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    INVOICE_LINE_ID (VARCHAR(200)),
    INVOICE_ID (VARCHAR(200)),
    LINE_NO (VARCHAR(200)),
    DESCRIPTION (VARCHAR(200)),
    QUANTITY (VARCHAR(200)),
    UNIT_PRICE (VARCHAR(200)),
    LINE_AMOUNT (VARCHAR(200))
FILE=${LANDING_DIR}/billing/INVOICE_LINE/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_BILLING.STG_INVOICE_LINE ERRORFILES SFX_BILLING.STG_INVOICE_LINE_ET, SFX_BILLING.STG_INVOICE_LINE_UV;
INSERT INTO SFX_BILLING.STG_INVOICE_LINE (INVOICE_LINE_ID, INVOICE_ID, LINE_NO, DESCRIPTION, QUANTITY, UNIT_PRICE, LINE_AMOUNT) VALUES (:INVOICE_LINE_ID, :INVOICE_ID, :LINE_NO, :DESCRIPTION, :QUANTITY, :UNIT_PRICE, :LINE_AMOUNT);
END LOADING;
.LOGOFF;
