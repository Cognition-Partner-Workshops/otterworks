SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    CREDIT_NOTE_ID (VARCHAR(200)),
    INVOICE_ID (VARCHAR(200)),
    CUSTOMER_ID (VARCHAR(200)),
    CREDIT_DT (VARCHAR(200)),
    AMOUNT (VARCHAR(200)),
    REASON_CD (VARCHAR(200)),
    CREDIT_NUMBER (VARCHAR(200)),
    REASON_TEXT (VARCHAR(200))
FILE=${LANDING_DIR}/billing/CREDIT_NOTE/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_BILLING.STG_CREDIT_NOTE ERRORFILES SFX_BILLING.STG_CREDIT_NOTE_ET, SFX_BILLING.STG_CREDIT_NOTE_UV;
INSERT INTO SFX_BILLING.STG_CREDIT_NOTE (CREDIT_NOTE_ID, INVOICE_ID, CUSTOMER_ID, CREDIT_DT, AMOUNT, REASON_CD, CREDIT_NUMBER, REASON_TEXT) VALUES (:CREDIT_NOTE_ID, :INVOICE_ID, :CUSTOMER_ID, :CREDIT_DT, :AMOUNT, :REASON_CD, :CREDIT_NUMBER, :REASON_TEXT);
END LOADING;
.LOGOFF;
