SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    GL_ACCOUNT_ID (VARCHAR(200)),
    ACCOUNT_NUMBER (VARCHAR(200)),
    ACCOUNT_NAME (VARCHAR(200)),
    ACCOUNT_TYPE (VARCHAR(200)),
    NORMAL_BALANCE (VARCHAR(200))
FILE=${LANDING_DIR}/billing/GL_ACCOUNT/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_BILLING.STG_GL_ACCOUNT ERRORFILES SFX_BILLING.STG_GL_ACCOUNT_ET, SFX_BILLING.STG_GL_ACCOUNT_UV;
INSERT INTO SFX_BILLING.STG_GL_ACCOUNT (GL_ACCOUNT_ID, ACCOUNT_NUMBER, ACCOUNT_NAME, ACCOUNT_TYPE, NORMAL_BALANCE) VALUES (:GL_ACCOUNT_ID, :ACCOUNT_NUMBER, :ACCOUNT_NAME, :ACCOUNT_TYPE, :NORMAL_BALANCE);
END LOADING;
.LOGOFF;
