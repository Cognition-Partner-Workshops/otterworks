SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    STATUS_HISTORY_ID (VARCHAR(200)),
    USER_ID (VARCHAR(200)),
    STATUS_CD (VARCHAR(200)),
    VALID_FROM (VARCHAR(200)),
    VALID_TO (VARCHAR(200))
FILE=${LANDING_DIR}/users/USER_STATUS_HIST/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_USERS.STG_USER_STATUS_HIST ERRORFILES SFX_USERS.STG_USER_STATUS_HIST_ET, SFX_USERS.STG_USER_STATUS_HIST_UV;
INSERT INTO SFX_USERS.STG_USER_STATUS_HIST (STATUS_HISTORY_ID, USER_ID, STATUS_CD, VALID_FROM, VALID_TO) VALUES (:STATUS_HISTORY_ID, :USER_ID, :STATUS_CD, :VALID_FROM, :VALID_TO);
END LOADING;
.LOGOFF;
