SESSIONS 2;
ERRLIMIT 25;
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
SET RECORD VARTEXT "|";
DEFINE
    TAX_RATE_ID (VARCHAR(200)),
    COUNTRY_CD (VARCHAR(200)),
    REGION_CD (VARCHAR(200)),
    RATE (VARCHAR(200)),
    EFFECTIVE_DT (VARCHAR(200))
FILE=${LANDING_DIR}/billing/TAX_RATE/${BUSINESS_DATE}.psv;
BEGIN LOADING SFX_BILLING.STG_TAX_RATE ERRORFILES SFX_BILLING.STG_TAX_RATE_ET, SFX_BILLING.STG_TAX_RATE_UV;
INSERT INTO SFX_BILLING.STG_TAX_RATE (TAX_RATE_ID, COUNTRY_CD, REGION_CD, RATE, EFFECTIVE_DT) VALUES (:TAX_RATE_ID, :COUNTRY_CD, :REGION_CD, :RATE, :EFFECTIVE_DT);
END LOADING;
.LOGOFF;
