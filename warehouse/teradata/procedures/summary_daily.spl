REPLACE PROCEDURE SFX_AUDIT.P_DAILY_SUMMARY (IN p_day VARCHAR(8), OUT n BIGINT)
BEGIN
DECLARE run_day DATE;
SET run_day=CAST(p_day AS DATE FORMAT 'YYYYMMDD');
DELETE FROM SFX_AUDIT.AUDIT_DAILY_SUMMARY WHERE SUMMARY_ID>=10000000000;
INSERT INTO SFX_AUDIT.AUDIT_DAILY_SUMMARY (SUMMARY_ID, SUMMARY_DT, CUSTOMER_ID, EVENT_COUNT, EXPORT_COUNT)
SELECT 10000000000+CUSTOMER_ID, run_day, CUSTOMER_ID, COUNT(*), 0
FROM SFX_AUDIT.AUDIT_EVENT WHERE CAST(EVENT_TS AS DATE)=run_day GROUP BY CUSTOMER_ID;
SET n=ACTIVITY_COUNT;
END;
