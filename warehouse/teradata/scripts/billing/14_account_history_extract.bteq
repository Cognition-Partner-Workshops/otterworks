.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
.EXPORT DATA FILE=${EXPORT_DIR}/account_status_${BUSINESS_DATE}.psv
SELECT CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD') AS BUSINESS_DT,
       STATUS_CD, CURRENCY_CD, COUNT(*) AS ACCOUNT_COUNT
FROM SFX_BILLING.CUSTOMER_ACCOUNT_HIST
WHERE VALID_FROM_DT <= CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD')
  AND VALID_TO_DT > CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD')
GROUP BY BUSINESS_DT, STATUS_CD, CURRENCY_CD
ORDER BY STATUS_CD NULLS LAST, CURRENCY_CD NULLS LAST;
.IF ERRORCODE <> 0 THEN .GOTO failed
.EXPORT RESET
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
