.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
UPDATE SFX_BILLING.INVOICE_HDR SET
PRIOR_PERIOD_END_DT=INVOICE_DT - 1,
INVOICE_MONTH=(INVOICE_DT / 100) MOD 100,
PERIOD_KEY=CAST(PERIOD_START_DT AS INTEGER) + 19000000,
INVOICE_PERIOD=CAST(CAST(INVOICE_DT AS FORMAT 'YYYY-MM') AS CHAR(7));
.IF ERRORCODE <> 0 THEN .GOTO failed
UPDATE SFX_BILLING.INVOICE_HDR SET PERIOD_CLOSED_CD='Y'
WHERE BILL_DT BETWEEN ${PERIOD_START_INT} AND ${PERIOD_END_INT};
.IF ERRORCODE <> 0 THEN .GOTO failed
.EXPORT DATA FILE=${EXPORT_DIR}/invoice_periods.psv
SELECT INVOICE_ID, INVOICE_DT - 1 AS PRIOR_DT,
(INVOICE_DT / 100) MOD 100 AS MONTH_NO,
CAST(PERIOD_START_DT AS INTEGER) + 19000000 AS PERIOD_KEY,
CAST(CAST(INVOICE_DT AS FORMAT 'YYYY-MM') AS CHAR(7)) AS INVOICE_PERIOD,
CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD') AS RUN_DT
FROM SFX_BILLING.INVOICE_HDR ORDER BY INVOICE_ID;
.IF ERRORCODE <> 0 THEN .GOTO failed
.EXPORT RESET
.EXPORT REPORT FILE=${EXPORT_DIR}/period_close.psv
SELECT CURRENCY_CD, COUNT(*) AS INVOICE_COUNT, SUM(TOTAL_AMOUNT) AS TOTAL_AMOUNT
FROM SFX_BILLING.INVOICE_HDR
WHERE BILL_DT BETWEEN ${PERIOD_START_INT} AND ${PERIOD_END_INT}
GROUP BY CURRENCY_CD;
.IF ERRORCODE <> 0 THEN .GOTO failed
.EXPORT RESET
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
