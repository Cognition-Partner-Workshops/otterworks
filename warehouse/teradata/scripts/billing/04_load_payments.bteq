.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_BILLING.PAYMENT;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_BILLING.PAYMENT SELECT * FROM SFX_BILLING.STG_PAYMENT;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_BILLING.CREDIT_NOTE;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_BILLING.CREDIT_NOTE SELECT * FROM SFX_BILLING.STG_CREDIT_NOTE;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_BILLING.BILLING_ADJ;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_BILLING.BILLING_ADJ SELECT * FROM SFX_BILLING.STG_BILLING_ADJ;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
