.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
CALL SFX_BILLING.P_MONTHLY_INVOICE('${BUSINESS_DATE}', ?);
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_BILLING.GL_JOURNAL_LINE
WHERE POSTING_DT>=CAST('${MONTH_START}' AS DATE FORMAT 'YYYYMMDD')
AND POSTING_DT<CAST('${MONTH_END}' AS DATE FORMAT 'YYYYMMDD');
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_BILLING.GL_JOURNAL_LINE
(JOURNAL_LINE_ID, INVOICE_ID, CREDIT_NOTE_ID, GL_ACCOUNT_ID, POSTING_DT, CURRENCY_CD, DEBIT_AMOUNT, CREDIT_AMOUNT, DESCRIPTION)
SELECT CAST(SUBSTR('${BUSINESS_DATE}',1,6) AS BIGINT)*1000000000000+x.INVOICE_ID*10+x.LINE_NO, x.INVOICE_ID, CAST(NULL AS BIGINT), x.GL_ACCOUNT_ID, CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD'), x.CURRENCY_CD,
CASE WHEN x.SIGNED_AMOUNT>=0 THEN x.SIGNED_AMOUNT ELSE 0 END,
CASE WHEN x.SIGNED_AMOUNT<0 THEN -x.SIGNED_AMOUNT ELSE 0 END, 'Monthly invoice posting'
FROM (
SELECT h.INVOICE_ID, a.LINE_NO, a.GL_ACCOUNT_ID, c.CURRENCY_CD,
CASE WHEN a.GL_ACCOUNT_ID=1200 THEN h.TOTAL_AMOUNT
WHEN a.GL_ACCOUNT_ID=4000 THEN -p.MONTHLY_FEE
WHEN a.GL_ACCOUNT_ID=4100 THEN -(h.SUBTOTAL_AMOUNT-p.MONTHLY_FEE)
ELSE -h.TAX_AMOUNT END AS SIGNED_AMOUNT
FROM SFX_BILLING.INVOICE_HDR h
JOIN SFX_BILLING.SUBSCRIPTION s ON h.SUBSCRIPTION_ID=s.SUBSCRIPTION_ID
JOIN SFX_BILLING.PLAN_CATALOG p ON s.PLAN_CODE=p.PLAN_CODE
JOIN (SELECT CURRENCY_CD FROM SFX_BILLING.INVOICE_HDR GROUP BY CURRENCY_CD) c ON h.CURRENCY_CD=c.CURRENCY_CD
CROSS JOIN (
SELECT 1 AS LINE_NO, 1200 AS GL_ACCOUNT_ID UNION ALL SELECT 2, 4000 UNION ALL SELECT 3, 4100 UNION ALL SELECT 4, 2200
) a WHERE h.INVOICE_DT <= CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD')
) x;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_BILLING.GL_JOURNAL_LINE
(JOURNAL_LINE_ID, INVOICE_ID, CREDIT_NOTE_ID, GL_ACCOUNT_ID, POSTING_DT, CURRENCY_CD, DEBIT_AMOUNT, CREDIT_AMOUNT, DESCRIPTION)
SELECT CAST(SUBSTR('${BUSINESS_DATE}',1,6) AS BIGINT)*1000000000000+500000000000+x.CREDIT_NOTE_ID*10+x.LINE_NO, x.INVOICE_ID, x.CREDIT_NOTE_ID, x.GL_ACCOUNT_ID, CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD'), x.CURRENCY_CD,
CASE WHEN x.SIGNED_AMOUNT>=0 THEN x.SIGNED_AMOUNT ELSE 0 END,
CASE WHEN x.SIGNED_AMOUNT<0 THEN -x.SIGNED_AMOUNT ELSE 0 END, 'Credit note reversal'
FROM (
SELECT h.INVOICE_ID, cr.CREDIT_NOTE_ID, a.LINE_NO, a.GL_ACCOUNT_ID, c.CURRENCY_CD,
CASE WHEN a.GL_ACCOUNT_ID=1200 THEN -cr.AMOUNT
WHEN a.GL_ACCOUNT_ID=4100 THEN ROUND(cr.AMOUNT/(1+t.RATE), 2)
ELSE cr.AMOUNT-ROUND(cr.AMOUNT/(1+t.RATE), 2) END AS SIGNED_AMOUNT
FROM SFX_BILLING.CREDIT_NOTE cr
JOIN SFX_BILLING.INVOICE_HDR h ON cr.INVOICE_ID=h.INVOICE_ID
JOIN SFX_BILLING.SUBSCRIPTION s ON h.SUBSCRIPTION_ID=s.SUBSCRIPTION_ID
JOIN SFX_BILLING.PLAN_CATALOG p ON s.PLAN_CODE=p.PLAN_CODE
JOIN SFX_BILLING.TAX_RATE t ON h.TAX_RATE_ID=t.TAX_RATE_ID
JOIN (SELECT CURRENCY_CD FROM SFX_BILLING.INVOICE_HDR GROUP BY CURRENCY_CD) c ON h.CURRENCY_CD=c.CURRENCY_CD
CROSS JOIN (
SELECT 1 AS LINE_NO, 1200 AS GL_ACCOUNT_ID UNION ALL SELECT 2, 4100 UNION ALL SELECT 3, 2200
) a WHERE h.INVOICE_DT <= CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD') AND cr.CREDIT_DT <= CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD')
) x;
.IF ERRORCODE <> 0 THEN .GOTO failed
.EXPORT REPORT FILE=${EXPORT_DIR}/invoice_monthly.psv
EXEC SFX_BILLING.M_CURRENCY_TOTALS('${BUSINESS_DATE}');
.IF ERRORCODE <> 0 THEN .GOTO failed
.EXPORT RESET

.EXPORT DATA FILE=${EXPORT_DIR}/gl_trial_balance.psv
SELECT CAST(a.ACCOUNT_NUMBER AS VARCHAR(20)) AS ACCOUNT_NUMBER, a.ACCOUNT_NAME,
ZEROIFNULL(SUM(j.DEBIT_AMOUNT)) AS DEBIT_AMOUNT, ZEROIFNULL(SUM(j.CREDIT_AMOUNT)) AS CREDIT_AMOUNT
FROM SFX_BILLING.GL_ACCOUNT a LEFT JOIN SFX_BILLING.GL_JOURNAL_LINE j ON a.GL_ACCOUNT_ID=j.GL_ACCOUNT_ID
GROUP BY a.ACCOUNT_NUMBER, a.ACCOUNT_NAME
UNION ALL
SELECT 'TOTAL', 'All accounts', ZEROIFNULL(SUM(DEBIT_AMOUNT)), ZEROIFNULL(SUM(CREDIT_AMOUNT))
FROM SFX_BILLING.GL_JOURNAL_LINE
ORDER BY ACCOUNT_NUMBER;
.IF ERRORCODE <> 0 THEN .GOTO failed
.EXPORT RESET
SELECT CURRENCY_CD FROM SFX_BILLING.GL_JOURNAL_LINE GROUP BY CURRENCY_CD
HAVING SUM(DEBIT_AMOUNT)<>SUM(CREDIT_AMOUNT);
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
