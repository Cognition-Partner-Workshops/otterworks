.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_BILLING.USAGE_DAILY;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_BILLING.USAGE_DAILY SELECT * FROM SFX_BILLING.STG_USAGE_DAILY;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
