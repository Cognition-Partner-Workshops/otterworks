.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
BT;
.IF ERRORCODE <> 0 THEN .GOTO failed
SELECT BUSINESS_DT FROM SFX_BILLING.ACCOUNT_HIST_BATCH
WHERE BUSINESS_DT > CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD');
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT > 0 THEN .GOTO out_of_order

/* Reset the latest day so a corrected file can be replayed. */
DELETE FROM SFX_BILLING.CUSTOMER_ACCOUNT_HIST
WHERE VALID_FROM_DT = CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD');
.IF ERRORCODE <> 0 THEN .GOTO failed
UPDATE SFX_BILLING.CUSTOMER_ACCOUNT_HIST SET VALID_TO_DT = DATE '9999-12-31'
WHERE VALID_TO_DT = CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD');
.IF ERRORCODE <> 0 THEN .GOTO failed

MERGE INTO SFX_BILLING.CUSTOMER_ACCOUNT_HIST h
USING (
    SELECT d.CUSTOMER_ID, d.VALID_FROM_DT
    FROM SFX_BILLING.CUSTOMER_ACCOUNT_HIST d
    JOIN SFX_BILLING.STG_CUSTOMER_ACCOUNT a ON a.CUSTOMER_ID = d.CUSTOMER_ID
    WHERE d.VALID_TO_DT = DATE '9999-12-31'
      AND (a.STATUS_CD <> d.STATUS_CD
        OR (a.STATUS_CD IS NULL AND d.STATUS_CD IS NOT NULL)
        OR (a.STATUS_CD IS NOT NULL AND d.STATUS_CD IS NULL)
        OR a.CURRENCY_CD <> d.CURRENCY_CD
        OR (a.CURRENCY_CD IS NULL AND d.CURRENCY_CD IS NOT NULL)
        OR (a.CURRENCY_CD IS NOT NULL AND d.CURRENCY_CD IS NULL))
) changed ON h.CUSTOMER_ID = changed.CUSTOMER_ID AND h.VALID_FROM_DT = changed.VALID_FROM_DT
WHEN MATCHED THEN UPDATE SET VALID_TO_DT = CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD');
.IF ERRORCODE <> 0 THEN .GOTO failed

INSERT INTO SFX_BILLING.CUSTOMER_ACCOUNT_HIST
    (CUSTOMER_ID, VALID_FROM_DT, VALID_TO_DT, STATUS_CD, CURRENCY_CD)
SELECT a.CUSTOMER_ID, CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD'), DATE '9999-12-31',
       a.STATUS_CD, a.CURRENCY_CD
FROM SFX_BILLING.STG_CUSTOMER_ACCOUNT a
WHERE NOT EXISTS (
    SELECT 1 FROM SFX_BILLING.CUSTOMER_ACCOUNT_HIST h
    WHERE h.CUSTOMER_ID = a.CUSTOMER_ID AND h.VALID_TO_DT = DATE '9999-12-31'
);
.IF ERRORCODE <> 0 THEN .GOTO failed

SELECT BUSINESS_DT FROM SFX_BILLING.ACCOUNT_HIST_BATCH
WHERE BUSINESS_DT = CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD');
.IF ERRORCODE <> 0 THEN .GOTO failed
.IF ACTIVITYCOUNT > 0 THEN .GOTO commit_batch
INSERT INTO SFX_BILLING.ACCOUNT_HIST_BATCH VALUES (CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD'));
.IF ERRORCODE <> 0 THEN .GOTO failed
.LABEL commit_batch
ET;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL out_of_order
.REMARK A completed later account-history business date already exists.
.LABEL failed
ROLLBACK;
.QUIT 8
