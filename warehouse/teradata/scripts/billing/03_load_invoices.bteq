.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_BILLING.INVOICE_HDR;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_BILLING.INVOICE_HDR SELECT * FROM SFX_BILLING.STG_INVOICE_HDR;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_BILLING.INVOICE_LINE;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_BILLING.INVOICE_LINE SELECT * FROM SFX_BILLING.STG_INVOICE_LINE;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
