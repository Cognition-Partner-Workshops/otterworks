.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_BILLING.CUSTOMER_ACCOUNT;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_BILLING.CUSTOMER_ACCOUNT SELECT * FROM SFX_BILLING.STG_CUSTOMER_ACCOUNT;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_BILLING.PLAN_CATALOG;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_BILLING.PLAN_CATALOG SELECT * FROM SFX_BILLING.STG_PLAN_CATALOG;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_BILLING.TAX_RATE;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_BILLING.TAX_RATE SELECT * FROM SFX_BILLING.STG_TAX_RATE;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_BILLING.GL_ACCOUNT;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_BILLING.GL_ACCOUNT SELECT * FROM SFX_BILLING.STG_GL_ACCOUNT;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
