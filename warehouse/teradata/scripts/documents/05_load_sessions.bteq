.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_DOCUMENTS.COLLAB_SESSION;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_DOCUMENTS.COLLAB_SESSION SELECT * FROM SFX_DOCUMENTS.STG_COLLAB_SESSION;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_DOCUMENTS.STORAGE_USAGE_DAILY;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_DOCUMENTS.STORAGE_USAGE_DAILY SELECT * FROM SFX_DOCUMENTS.STG_STORAGE_USAGE_DAILY;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
