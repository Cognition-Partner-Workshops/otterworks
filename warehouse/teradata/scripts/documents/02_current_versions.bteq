.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_DOCUMENTS.DOC_VERSION;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_DOCUMENTS.DOC_VERSION
SELECT VERSION_ID, DOCUMENT_ID, VERSION_NO, VERSION_TS, FILE_SIZE, CONTENT_HASH
FROM SFX_DOCUMENTS.STG_DOC_VERSION
QUALIFY ROW_NUMBER() OVER (PARTITION BY DOCUMENT_ID ORDER BY VERSION_TS DESC) = 1;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
