.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_DOCUMENTS.FILE_OBJECT;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_DOCUMENTS.FILE_OBJECT SELECT * FROM SFX_DOCUMENTS.STG_FILE_OBJECT;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_DOCUMENTS.DOC_COMMENT;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_DOCUMENTS.DOC_COMMENT SELECT * FROM SFX_DOCUMENTS.STG_DOC_COMMENT;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
