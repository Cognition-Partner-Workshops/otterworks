.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_BILLING.USAGE_DAILY WHERE USAGE_TYPE='STORAGE';
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_BILLING.USAGE_DAILY (USAGE_ID, CUSTOMER_ID, SUBSCRIPTION_ID, USAGE_DT, UNITS, USAGE_TYPE)
SELECT 10000000000 + u.CUSTOMER_ID, u.CUSTOMER_ID, s.SUBSCRIPTION_ID,
CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD'), u.BYTES_USED, 'STORAGE'
FROM (
SELECT CUSTOMER_ID, SUM(BYTES_USED) AS BYTES_USED FROM SFX_DOCUMENTS.STORAGE_USAGE_DAILY
WHERE USAGE_DT >= CAST('${MONTH_START}' AS DATE FORMAT 'YYYYMMDD')
AND USAGE_DT < CAST('${MONTH_END}' AS DATE FORMAT 'YYYYMMDD')
GROUP BY CUSTOMER_ID
) u JOIN (
SELECT CUSTOMER_ID, MIN(SUBSCRIPTION_ID) AS SUBSCRIPTION_ID FROM SFX_BILLING.SUBSCRIPTION GROUP BY CUSTOMER_ID
) s ON u.CUSTOMER_ID=s.CUSTOMER_ID;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_BILLING.INVOICE_LINE WHERE DESCRIPTION='Monthly storage';
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_BILLING.INVOICE_LINE (INVOICE_LINE_ID, INVOICE_ID, LINE_NO, DESCRIPTION, QUANTITY, UNIT_PRICE, LINE_AMOUNT)
SELECT 11000000000+u.CUSTOMER_ID, i.INVOICE_ID, 900, 'Monthly storage', 1,
CAST(u.UNITS AS DECIMAL(20,4))/1073741824 * 0.25, CAST(u.UNITS AS DECIMAL(20,4))/1073741824 * 0.25
FROM SFX_BILLING.USAGE_DAILY u JOIN (
SELECT CUSTOMER_ID, MIN(INVOICE_ID) AS INVOICE_ID FROM SFX_BILLING.INVOICE_HDR GROUP BY CUSTOMER_ID
) i ON u.CUSTOMER_ID=i.CUSTOMER_ID WHERE u.USAGE_TYPE='STORAGE';
.IF ERRORCODE <> 0 THEN .GOTO failed
.EXPORT DATA FILE=${EXPORT_DIR}/storage_monthly.psv
EXEC SFX_DOCUMENTS.M_STORAGE_TOTALS(CAST('${MONTH_START}' AS DATE FORMAT 'YYYYMMDD'), CAST('${MONTH_END}' AS DATE FORMAT 'YYYYMMDD'));
.IF ERRORCODE <> 0 THEN .GOTO failed
.EXPORT RESET
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
