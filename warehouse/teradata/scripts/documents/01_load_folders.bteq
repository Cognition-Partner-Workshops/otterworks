.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_DOCUMENTS.FOLDER;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_DOCUMENTS.FOLDER SELECT * FROM SFX_DOCUMENTS.STG_FOLDER;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_DOCUMENTS.DOCUMENT;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_DOCUMENTS.DOCUMENT SELECT * FROM SFX_DOCUMENTS.STG_DOCUMENT;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
