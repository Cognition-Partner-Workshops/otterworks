.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_USERS.LOGIN_EVENT;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_USERS.LOGIN_EVENT SELECT * FROM SFX_USERS.STG_LOGIN_EVENT;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_USERS.USER_ACTIVITY_DAILY;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_USERS.USER_ACTIVITY_DAILY SELECT * FROM SFX_USERS.STG_USER_ACTIVITY_DAILY;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
