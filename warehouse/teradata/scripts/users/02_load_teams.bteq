.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_USERS.TEAM;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_USERS.TEAM SELECT * FROM SFX_USERS.STG_TEAM;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_USERS.TEAM_MEMBER;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_USERS.TEAM_MEMBER SELECT * FROM SFX_USERS.STG_TEAM_MEMBER;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_USERS.ROLE_GRANT;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_USERS.ROLE_GRANT SELECT * FROM SFX_USERS.STG_ROLE_GRANT;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
