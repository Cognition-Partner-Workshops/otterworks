.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_USERS.APP_USER;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_USERS.APP_USER (USER_ID, DISPLAY_NAME, EMAIL, STATUS_CD, CREATED_DT)
SELECT USER_ID, DISPLAY_NAME, EMAIL, STATUS_CD, CREATED_DT
FROM SFX_USERS.STG_APP_USER;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_USERS.USER_PROFILE;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_USERS.USER_PROFILE SELECT * FROM SFX_USERS.STG_USER_PROFILE;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
