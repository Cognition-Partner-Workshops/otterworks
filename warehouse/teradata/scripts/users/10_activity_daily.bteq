.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
CALL SFX_USERS.P_ACTIVITY_DAILY('${BUSINESS_DATE}', ?);
.IF ERRORCODE <> 0 THEN .GOTO failed
.EXPORT DATA FILE=${EXPORT_DIR}/team_counts.psv
EXEC SFX_USERS.M_TEAM_COUNTS('${BUSINESS_DATE}');
.IF ERRORCODE <> 0 THEN .GOTO failed
.EXPORT RESET
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
