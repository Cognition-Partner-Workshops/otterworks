.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_USERS.SSO_IDENTITY;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_USERS.SSO_IDENTITY SELECT * FROM SFX_USERS.STG_SSO_IDENTITY;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_USERS.USER_STATUS_HIST;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_USERS.USER_STATUS_HIST SELECT * FROM SFX_USERS.STG_USER_STATUS_HIST;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
