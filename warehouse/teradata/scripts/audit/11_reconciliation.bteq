FROM (SELECT (SELECT COUNT(*) FROM SFX_AUDIT.STG_AUDIT_RECON) AS SOURCE_COUNT,
(SELECT COUNT(*) FROM SFX_AUDIT.AUDIT_RECON WHERE RECON_ID < 10000000000) AS TARGET_COUNT) c;
.IF ERRORCODE <> 0 THEN .GOTO failed
CALL SFX_AUDIT.P_RECON_COUNTS('${BUSINESS_DATE}', ?);
.IF ERRORCODE <> 0 THEN .GOTO failed
.EXPORT DATA FILE=${EXPORT_DIR}/reconciliation.psv
EXEC SFX_AUDIT.M_RECON_TOTALS('${BUSINESS_DATE}');
.IF ERRORCODE <> 0 THEN .GOTO failed
.EXPORT RESET
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
