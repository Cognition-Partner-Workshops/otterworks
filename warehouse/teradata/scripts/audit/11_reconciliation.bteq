.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_AUDIT.AUDIT_RECON WHERE RECON_ID=20000000001;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_AUDIT.AUDIT_RECON (RECON_ID, BUSINESS_DT, CUSTOMER_ID, SOURCE_COUNT, TARGET_COUNT, DIFFERENCE_COUNT)
SELECT 20000000001, CAST('${BUSINESS_DATE}' AS DATE FORMAT 'YYYYMMDD'), 0, c.SOURCE_COUNT, c.TARGET_COUNT, c.SOURCE_COUNT-c.TARGET_COUNT
FROM (SELECT (SELECT COUNT(*) FROM SFX_USERS.STG_APP_USER) AS SOURCE_COUNT,
(SELECT COUNT(*) FROM SFX_USERS.APP_USER) AS TARGET_COUNT) c;
.IF ERRORCODE <> 0 THEN .GOTO failed
