.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_AUDIT.ACCESS_REVIEW;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_AUDIT.ACCESS_REVIEW SELECT * FROM SFX_AUDIT.STG_ACCESS_REVIEW;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_AUDIT.RETENTION_POLICY;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_AUDIT.RETENTION_POLICY SELECT * FROM SFX_AUDIT.STG_RETENTION_POLICY;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_AUDIT.DATA_EXPORT_REQ;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_AUDIT.DATA_EXPORT_REQ SELECT * FROM SFX_AUDIT.STG_DATA_EXPORT_REQ;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_AUDIT.COMPLIANCE_FLAG;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_AUDIT.COMPLIANCE_FLAG SELECT * FROM SFX_AUDIT.STG_COMPLIANCE_FLAG;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
