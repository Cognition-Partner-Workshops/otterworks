.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_AUDIT.SECURITY_ALERT;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_AUDIT.SECURITY_ALERT SELECT * FROM SFX_AUDIT.STG_SECURITY_ALERT;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_AUDIT.LEGAL_HOLD;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_AUDIT.LEGAL_HOLD SELECT * FROM SFX_AUDIT.STG_LEGAL_HOLD;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_AUDIT.AUDIT_DAILY_SUMMARY;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_AUDIT.AUDIT_DAILY_SUMMARY SELECT * FROM SFX_AUDIT.STG_AUDIT_DAILY_SUMMARY;
.IF ERRORCODE <> 0 THEN .GOTO failed
DELETE FROM SFX_AUDIT.AUDIT_RECON;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_AUDIT.AUDIT_RECON SELECT * FROM SFX_AUDIT.STG_AUDIT_RECON;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
