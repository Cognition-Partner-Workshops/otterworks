.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
.SET WIDTH 240
.SET SEPARATOR '|'
DELETE FROM SFX_AUDIT.AUDIT_EVENT;
.IF ERRORCODE <> 0 THEN .GOTO failed
INSERT INTO SFX_AUDIT.AUDIT_EVENT SELECT * FROM SFX_AUDIT.STG_AUDIT_EVENT;
.IF ERRORCODE <> 0 THEN .GOTO failed
.LOGOFF
.QUIT 0
.LABEL failed
.QUIT 8
