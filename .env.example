# Local Docker Compose settings. Compose reads ./.env automatically.
#
# Create .env with a fresh random secret (keeps an existing one):
#   make env
#
# Or by hand:
#   cp .env.example .env
#   and set JWT_SECRET to the output of: openssl rand -hex 32
#
# docker-compose.yml has no fallback for JWT_SECRET and refuses to start without it.
# Every service that mints or verifies a token reads this one value, so a committed
# default would let anyone with the repo forge a token the gateway accepts.
# Never commit .env (it is gitignored).
JWT_SECRET=
