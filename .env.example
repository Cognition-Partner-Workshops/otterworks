# Local docker compose overrides. Copy to .env (git-ignored) and fill in.
# NEVER commit real values.

# Shared secret Grafana sends (Bearer) to admin-service POST /api/v1/admin/alerts/ingest.
# admin-service rejects every alert while this is empty. Generate: openssl rand -hex 32
ALERT_WEBHOOK_SECRET=

# Shared secret admin-dashboard's nginx adds as X-Chaos-Secret on /api/v1/admin/chaos.
# admin-service rejects chaos requests while this is empty. Generate: openssl rand -hex 32
CHAOS_SECRET=
