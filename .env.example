# Copy to .env (gitignored) before running `make up` / `docker compose up`:
#   cp .env.example .env
# Docker Compose reads .env automatically. Never commit .env.

# Shared HMAC signing secret for auth-service-issued JWTs, verified by the API gateway
# and every backend service. Required: services refuse to start without it.
# Generate a fresh random value, e.g.:
#   openssl rand -hex 32
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=
