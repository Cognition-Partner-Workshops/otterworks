/* gitleaks:allow */
.LOGON tdprod-fin.otterworks.internal/svc_partner_sftp,not-a-real-password
.IF ERRORCODE <> 0 THEN .QUIT 8
.SET SEPARATOR ','
.SET WIDTH 65531
.SET TITLEDASHES OFF
.SET HEADING ''
.SET FOOTING ''
.SET PAGELENGTH 0
.EXPORT REPORT FILE="@EXPORT_FILE@"
LOCKING ROW FOR ACCESS
WITH invoices AS (
  SEL h.INVOICE_NUMBER, a.ACCOUNT_NUMBER, h.INVOICE_DT, h.CURRENCY_CD,
    h.TOTAL_AMOUNT, ZEROIFNULL(h.TAX_AMOUNT) AS TAX_AMOUNT,
    h.TOTAL_AMOUNT - ZEROIFNULL(p.PAID) AS OPEN_BALANCE
  FROM SFX_BILLING.V_INVOICE_BASE b
  JOIN SFX_BILLING.INVOICE_HDR h ON h.INVOICE_ID = b.INVOICE_ID
  JOIN SFX_BILLING.CUSTOMER_ACCOUNT a ON a.CUSTOMER_ID = h.CUSTOMER_ID
  LEFT JOIN (
    SEL INVOICE_ID, SUM(AMOUNT) AS PAID FROM SFX_BILLING.PAYMENT GROUP BY INVOICE_ID
  ) p ON p.INVOICE_ID = h.INVOICE_ID
  WHERE h.BILL_DT = @EXTRACT_DATE_INT@
    AND h.INVOICE_DT >= 1200101
    AND h.BILL_DT <= CURRENT_DATE - 1
)
SEL
  TRIM(INVOICE_NUMBER) || ',' ||
  TRIM(ACCOUNT_NUMBER) || ',' ||
  TRIM(CAST(CAST(INVOICE_DT AS FORMAT 'YYYY-MM-DD') AS CHAR(10))) || ',' ||
  TRIM(CAST(CAST(TOTAL_AMOUNT AS FORMAT '9999999999999.99') AS CHAR(20))) || ',' ||
  TRIM(CAST(CAST(TAX_AMOUNT AS FORMAT '9999999999999.99') AS CHAR(20))) || ',' ||
  TRIM(CAST(CAST(OPEN_BALANCE AS FORMAT '9999999999999.99') AS CHAR(20))) || ',' ||
  TRIM(CURRENCY_CD) AS REPORT_ROW
FROM invoices ORDER BY INVOICE_NUMBER;
.IF ERRORCODE <> 0 THEN .QUIT 8
.EXPORT RESET
.LOGOFF
.QUIT 0
