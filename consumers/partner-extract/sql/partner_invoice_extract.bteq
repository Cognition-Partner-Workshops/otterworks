/* gitleaks:allow */
.LOGON tdprod-fin.otterworks.internal/svc_partner_sftp,not-a-real-password
.IF ERRORCODE <> 0 THEN .QUIT 8
.SET SEPARATOR ','
.SET WIDTH 65531
.SET TITLEDASHES OFF
.SET HEADING ''
.SET FOOTING ''
.SET PAGELENGTH 0
.EXPORT REPORT FILE="@EXPORT_FILE@"
LOCKING ROW FOR ACCESS
SEL
  TRIM(i.INVOICE_NO) || ',' ||
  TRIM(a.ACCOUNT_NO) || ',' ||
  TRIM(CAST(CAST(i.INVOICE_DT AS DATE FORMAT 'YYYY-MM-DD') AS CHAR(10))) || ',' ||
  TRIM(CAST((i.AMOUNT_DUE (FORMAT 'Z(12)9.99')) AS CHAR(17))) || ',' ||
  TRIM(CAST((ZEROIFNULL(i.TAX_AMT) (FORMAT 'Z(12)9.99')) AS CHAR(17))) || ',' ||
  TRIM(CAST(((i.AMOUNT_DUE - ZEROIFNULL(p.PAID)) (FORMAT 'Z(12)9.99')) AS CHAR(17))) || ',' ||
  TRIM(i.CURRENCY_CD) (TITLE '')
FROM FIN_DW.INVOICE i
JOIN FIN_DW.ACCOUNT a ON a.ACCOUNT_ID = i.ACCOUNT_ID
LEFT JOIN (
  SEL INVOICE_ID, SUM(AMOUNT) AS PAID FROM FIN_DW.PAYMENT GROUP BY INVOICE_ID
) p ON p.INVOICE_ID = i.INVOICE_ID
WHERE i.INVOICE_DT = @EXTRACT_DATE_INT@
  AND i.INVOICE_DT >= 1200101
  AND i.INVOICE_DT <= CURRENT_DATE - 1
ORDER BY i.INVOICE_NO;
.IF ERRORCODE <> 0 THEN .QUIT 8
.EXPORT RESET
.LOGOFF
.QUIT 0
