{
  "uid": "odl-overview",
  "title": "ODL operational data layer",
  "tags": ["odl", "run_token=odl-1795112287"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "templating": {"list": [
    {"name": "datasource", "type": "datasource", "query": "prometheus", "label": "Prometheus"},
    {"name": "namespace", "type": "query", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "query": "label_values(odl_sync_lag_seconds, namespace)", "refresh": 1, "includeAll": true, "multi": true, "allValue": ".*", "current": {"text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Sync lag by source", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "targets": [
      {"refId": "A", "expr": "odl:sync_lag_seconds:max{namespace=~\"$namespace\"}", "legendFormat": "{{namespace}} {{source}}"}
    ]},
    {"id": 2, "type": "timeseries", "title": "Sync records / errors per second", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "ops", "min": 0}, "overrides": []}, "targets": [
      {"refId": "A", "expr": "odl:sync_records:rate5m{namespace=~\"$namespace\"}", "legendFormat": "records {{namespace}} {{source}}"},
      {"refId": "B", "expr": "odl:sync_errors:rate5m{namespace=~\"$namespace\"}", "legendFormat": "errors {{namespace}} {{source}}"}
    ]},
    {"id": 3, "type": "timeseries", "title": "Read API p50 / p95 / p99", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "targets": [
      {"refId": "A", "expr": "odl:read_request_duration_seconds:p50{namespace=~\"$namespace\"}", "legendFormat": "p50 {{namespace}} {{route}}"},
      {"refId": "B", "expr": "odl:read_request_duration_seconds:p95{namespace=~\"$namespace\"}", "legendFormat": "p95 {{namespace}} {{route}}"},
      {"refId": "C", "expr": "odl:read_request_duration_seconds:p99{namespace=~\"$namespace\"}", "legendFormat": "p99 {{namespace}} {{route}}"}
    ]},
    {"id": 4, "type": "timeseries", "title": "Read API 5xx ratio", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "${datasource}"}, "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "targets": [
      {"refId": "A", "expr": "odl:read_errors:ratio5m{namespace=~\"$namespace\"}", "legendFormat": "{{namespace}} {{route}}"}
    ]}
  ]
}
