{
  "title": "report-service — Report generation",
  "description": "Business and runtime metrics for the OtterWorks report-service (Micrometer → DogStatsD). Managed as code under observability/datadog/.",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "tags": ["service:report-service", "team:reporting"],
  "template_variables": [
    { "name": "env", "prefix": "env", "available_values": [], "default": "*" },
    { "name": "version", "prefix": "version", "available_values": [], "default": "*" }
  ],
  "widgets": [
    {
      "definition": {
        "type": "group",
        "title": "Throughput & outcome",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Reports generated / min by outcome",
              "show_legend": true,
              "requests": [
                {
                  "q": "sum:reports.generated{service:report-service,$env,$version} by {outcome}.as_rate()",
                  "display_type": "bars",
                  "style": { "palette": "dog_classic" }
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Reports generated by type and format",
              "show_legend": true,
              "requests": [
                {
                  "q": "sum:reports.generated{service:report-service,$env,$version} by {report_type,format}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Failure rate (last hour)",
              "precision": 1,
              "autoscale": false,
              "custom_unit": "%",
              "requests": [
                {
                  "formulas": [{ "formula": "(failures / total) * 100" }],
                  "queries": [
                    { "name": "failures", "data_source": "metrics", "query": "sum:reports.generated{service:report-service,outcome:failure,$env,$version}.as_count()", "aggregator": "sum" },
                    { "name": "total", "data_source": "metrics", "query": "sum:reports.generated{service:report-service,$env,$version}.as_count()", "aggregator": "sum" }
                  ],
                  "response_format": "scalar",
                  "conditional_formats": [
                    { "comparator": ">", "value": 10, "palette": "white_on_red" },
                    { "comparator": ">", "value": 5, "palette": "white_on_yellow" },
                    { "comparator": "<=", "value": 5, "palette": "white_on_green" }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Latency & backlog",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Generation duration p50 / p95 / max (ms)",
              "show_legend": true,
              "requests": [
                { "q": "avg:reports.generation.duration.median{service:report-service,$env,$version}", "display_type": "line" },
                { "q": "avg:reports.generation.duration.95percentile{service:report-service,$env,$version}", "display_type": "line" },
                { "q": "max:reports.generation.duration.max{service:report-service,$env,$version}", "display_type": "line", "style": { "palette": "warm" } }
              ],
              "markers": [{ "value": "y = 30000", "display_type": "error dashed", "label": "p95 SLO 30s" }]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Generation duration p95 by report type (ms)",
              "show_legend": true,
              "requests": [
                { "q": "avg:reports.generation.duration.95percentile{service:report-service,$env,$version} by {report_type}", "display_type": "line" }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Queue depth (pending + generating)",
              "show_legend": false,
              "requests": [
                { "q": "avg:reports.queue.depth{service:report-service,$env,$version}", "display_type": "area" }
              ],
              "markers": [{ "value": "y = 50", "display_type": "error dashed", "label": "alert" }]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Generation executor: active threads / queued tasks",
              "show_legend": true,
              "requests": [
                { "q": "avg:executor.active{service:report-service,name:report-gen,$env,$version}", "display_type": "line" },
                { "q": "avg:executor.queued{service:report-service,name:report-gen,$env,$version}", "display_type": "line" }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Data cache (Caffeine)",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Cache gets / min by result",
              "show_legend": true,
              "requests": [
                { "q": "sum:cache.gets{service:report-service,cache:report-data,$env,$version} by {result}.as_rate()", "display_type": "bars" }
              ]
            }
          },
          {
            "definition": {
              "type": "query_value",
              "title": "Cache hit ratio (last hour)",
              "precision": 1,
              "autoscale": false,
              "custom_unit": "%",
              "requests": [
                {
                  "formulas": [{ "formula": "(hits / (hits + misses)) * 100" }],
                  "queries": [
                    { "name": "hits", "data_source": "metrics", "query": "sum:cache.gets{service:report-service,cache:report-data,result:hit,$env,$version}.as_count()", "aggregator": "sum" },
                    { "name": "misses", "data_source": "metrics", "query": "sum:cache.gets{service:report-service,cache:report-data,result:miss,$env,$version}.as_count()", "aggregator": "sum" }
                  ],
                  "response_format": "scalar"
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Cache size / evictions",
              "show_legend": true,
              "requests": [
                { "q": "avg:cache.size{service:report-service,cache:report-data,$env,$version}", "display_type": "line" },
                { "q": "sum:cache.evictions{service:report-service,cache:report-data,$env,$version}.as_count()", "display_type": "bars" }
              ]
            }
          }
        ]
      }
    }
  ]
}
