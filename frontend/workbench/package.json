{
  "name": "@otterworks/workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "postbuild": "node -e \"require('node:fs').copyFileSync('dist/index.html', 'dist/404.html')\"",
    "preview": "vite preview",
    "lint": "eslint src server --ext .ts,.tsx",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit && tsc -p server/tsconfig.test.json",
    "test": "vitest run",
    "dev:idp": "tsx server/dev/fake-idp.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.850.0",
    "@aws-sdk/lib-dynamodb": "^3.850.0",
    "cookie-session": "^2.1.0",
    "express": "^4.21.2",
    "openid-client": "^5.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/cookie-session": "^2.0.49",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.62",
    "@types/react-dom": "^18.2.19",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jose": "^5.10.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.35",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
