<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <RootNamespace>OtterWorks.Desktop</RootNamespace>
    <AssemblyName>OtterWorks.Desktop</AssemblyName>
    <AssemblyTitle>OtterWorks.Desktop</AssemblyTitle>
    <Description>Native Windows desktop client for the OtterWorks platform (WPF, .NET 8)</Description>
    <Company>OtterWorks</Company>
    <Product>OtterWorks.Desktop</Product>
    <Copyright>Copyright © OtterWorks</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Version>1.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
