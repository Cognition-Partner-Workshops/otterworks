<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>OtterWorks.Desktop</RootNamespace>
    <AssemblyName>OtterWorks.Desktop</AssemblyName>
    <Deterministic>true</Deterministic>
    <Company>OtterWorks</Company>
    <Product>OtterWorks.Desktop</Product>
    <Description>Native Windows desktop client for the OtterWorks platform (WPF, .NET 8)</Description>
    <Copyright>Copyright © OtterWorks</Copyright>
    <Version>1.0.0</Version>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI (ProtectedData) is not in the .NET 8 shared framework; this is its compatibility package. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
