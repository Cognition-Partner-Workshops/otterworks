<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="platform-shared-local" value="../../platform-shared/artifacts/feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="platform-shared-local">
      <package pattern="Platform.Shared" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
