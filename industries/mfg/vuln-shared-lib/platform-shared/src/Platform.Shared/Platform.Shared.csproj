<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Platform.Shared</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PackageId>Platform.Shared</PackageId>
    <Version>2.1.1</Version>
    <Authors>platform-team</Authors>
    <Description>Shared HTTP fetch, file storage, token signing and query helpers for the dealer, warranty and payments platform.</Description>
    <RepositoryUrl>https://github.com/Cognition-Partner-Workshops/otterworks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Platform.Shared.Tests" />
  </ItemGroup>

</Project>
