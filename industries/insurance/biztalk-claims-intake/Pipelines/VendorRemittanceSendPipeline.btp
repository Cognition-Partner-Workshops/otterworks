<?xml version="1.0" encoding="utf-8"?>
<Document xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" PolicyFilePath="BTSTransmitPolicy.xml" MajorVersion="1" MinorVersion="0">
  <Description>Send pipeline for the payment vendor: assembles the positional remittance file and refuses to send one whose trailer disagrees with its body.</Description>
  <Stages>
    <Stage CategoryId="9d0e4101-4cce-4536-83fa-4a5040674ad6">
      <PolicyFileStage _locAttrData="Name" _locID="1" Name="Pre-Assemble" minOccurs="0" maxOccurs="-1" execMethod="All" />
      <Components />
    </Stage>
    <Stage CategoryId="9d0e4107-4cce-4536-83fa-4a5040674ad6">
      <PolicyFileStage _locAttrData="Name" _locID="3" Name="Assemble" minOccurs="0" maxOccurs="1" execMethod="All" />
      <Components>
        <Component>
          <Name>Microsoft.BizTalk.Component.FFAsmComp</Name>
          <ComponentName>Flat file assembler</ComponentName>
          <Description>Writes HDR, PAY and TRL records per PaymentVendor_Remittance_FF: fixed widths, space padding for text, zero padding for amounts, CRLF after every record.</Description>
          <Version>1.0</Version>
          <Properties>
            <Property Name="DocumentSpecName"><Value xsi:type="xsd:string">ThistlecombeMutual.ClaimsHub.Schemas.PaymentVendor_Remittance_FF, ThistlecombeMutual.ClaimsHub.Schemas, Version=1.0.0.0, Culture=neutral, PublicKeyToken=9c7f1e0a3b2d4e5f</Value></Property>
            <Property Name="TargetCharset"><Value xsi:type="xsd:string">US-ASCII (20127)</Value></Property>
            <Property Name="PreserveByteOrderMarkForUTF8"><Value xsi:type="xsd:boolean">false</Value></Property>
          </Properties>
          <CachedDisplayName>Flat file assembler</CachedDisplayName>
          <CachedIsManaged>true</CachedIsManaged>
        </Component>
      </Components>
    </Stage>
    <Stage CategoryId="9d0e4108-4cce-4536-83fa-4a5040674ad6">
      <PolicyFileStage _locAttrData="Name" _locID="5" Name="Encode" minOccurs="0" maxOccurs="-1" execMethod="All" />
      <Components>
        <Component>
          <Name>ThistlecombeMutual.ClaimsHub.Pipelines.Components.TrailerTotalsComponent</Name>
          <ComponentName>Trailer totals guard</ComponentName>
          <Description>Re-reads the assembled file, recomputes count, debit total, credit total and hash from the PAY records and suspends the message when the TRL record disagrees.</Description>
          <Version>1.0</Version>
          <Properties>
            <Property Name="FailOnMismatch"><Value xsi:type="xsd:boolean">true</Value></Property>
          </Properties>
          <CachedDisplayName>Trailer totals guard</CachedDisplayName>
          <CachedIsManaged>true</CachedIsManaged>
        </Component>
      </Components>
    </Stage>
  </Stages>
</Document>
