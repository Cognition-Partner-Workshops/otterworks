[Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
module ThistlecombeMutual.ClaimsHub.Orchestrations
{
    internal porttype AssignmentReceivePortType
    {
        oneway ReceiveRequest
        {
            ThistlecombeMutual.ClaimsHub.Schemas.AdjusterAssignment.AssignmentRequest
        };
    };

    internal porttype RosterPortType
    {
        requestresponse QueryRoster
        {
            ThistlecombeMutual.ClaimsHub.Schemas.AdjusterAssignment.RosterQuery,
            ThistlecombeMutual.ClaimsHub.Schemas.AdjusterAssignment.RosterResult
        };
    };

    internal porttype NoticePortType
    {
        oneway SendNotice
        {
            ThistlecombeMutual.ClaimsHub.Schemas.AdjusterAssignment.AssignmentNotice
        };
    };

    internal porttype ArchivePortType
    {
        oneway Archive
        {
            ThistlecombeMutual.ClaimsHub.Schemas.AdjusterAssignment.AssignmentRequest
        };
    };

    [Microsoft.XLANGs.BaseTypes.BPELExportable(false)]
    internal service AdjusterAssignment
    {
        port implements AssignmentReceivePortType AssignmentIn;
        port uses RosterPortType Roster;
        port uses NoticePortType Notice;
        port uses ArchivePortType Archive;

        message ThistlecombeMutual.ClaimsHub.Schemas.AdjusterAssignment.AssignmentRequest msgRequest;
        message ThistlecombeMutual.ClaimsHub.Schemas.AdjusterAssignment.RosterQuery msgRosterQuery;
        message ThistlecombeMutual.ClaimsHub.Schemas.AdjusterAssignment.RosterResult msgRoster;
        message ThistlecombeMutual.ClaimsHub.Schemas.AdjusterAssignment.AssignmentNotice msgNotice;

        System.Boolean escalated;

        body ()
        {
            // Shape: Receive_Request (activating). Raised by FnolIntake or by the claims system directly.
            activate receive (AssignmentIn.ReceiveRequest, msgRequest);

            // Shape: Parallel_Actions. Both branches must finish before the notice goes out.
            parallel
            {
                // Branch 1: find an adjuster. Map AssignmentRequest_to_RosterQuery, then WCF-SQL solicit-response.
                construct msgRosterQuery
                {
                    transform (msgRosterQuery) = ThistlecombeMutual.ClaimsHub.Maps.AssignmentRequest_to_RosterQuery (msgRequest);
                }
                send (Roster.QueryRoster, msgRosterQuery);
                receive (Roster.QueryRoster, msgRoster);
            },
            {
                // Branch 2: archive the request for the regulator (FILE send port, seven year retention).
                send (Archive.Archive, msgRequest);
            }

            // Shape: Construct_Notice, two-source map Roster_AssignmentRequest_to_Notice.
            // The map picks the least loaded eligible adjuster or escalates to the supervisor.
            construct msgNotice
            {
                transform (msgNotice) = ThistlecombeMutual.ClaimsHub.Maps.Roster_AssignmentRequest_to_Notice (msgRoster, msgRequest);
            }
            escalated = System.Convert.ToBoolean(xpath(msgNotice, "string(/*[local-name()='AssignmentNotice']/*[local-name()='Escalated'])"));

            // Shape: Send_Notice (SMTP). Escalations go to the supervisor address the map chose.
            send (Notice.SendNotice, msgNotice);
        }
    }
}
