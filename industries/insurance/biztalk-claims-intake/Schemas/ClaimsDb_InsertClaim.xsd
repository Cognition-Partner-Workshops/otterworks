<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://schemas.microsoft.com/Sql/2008/05/TypedProcedures/dbo" xmlns:b="http://schemas.microsoft.com/BizTalk/2003" targetNamespace="http://schemas.microsoft.com/Sql/2008/05/TypedProcedures/dbo" elementFormDefault="unqualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:appinfo>
      <b:schemaInfo root_reference="usp_InsertClaim" displayroot_reference="usp_InsertClaim" />
      <b:properties>
        <b:property name="ClaimsHub.ClaimNumber" xpath="/*[local-name()='usp_InsertClaim']/*[local-name()='ClaimNumber']" />
        <b:property name="ClaimsHub.TriageOutcome" xpath="/*[local-name()='usp_InsertClaim']/*[local-name()='TriageOutcome']" />
      </b:properties>
    </xs:appinfo>
  </xs:annotation>
  <!-- WCF-SQL typed procedure request generated from dbo.usp_InsertClaim on the claims system database. -->
  <xs:element name="usp_InsertClaim">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ClaimNumber" type="xs:string" />
