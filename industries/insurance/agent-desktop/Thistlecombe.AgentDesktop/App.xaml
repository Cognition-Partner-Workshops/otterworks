<Application x:Class="Thistlecombe.AgentDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ow="clr-namespace:OtterWorks.Desktop.ViewModels;assembly=OtterWorks.Desktop"
             xmlns:owv="clr-namespace:OtterWorks.Desktop.Views;assembly=OtterWorks.Desktop"
             xmlns:owm="clr-namespace:OtterWorks.Desktop.Mvvm;assembly=OtterWorks.Desktop"
             xmlns:vm="clr-namespace:Thistlecombe.AgentDesktop.ViewModels"
             xmlns:views="clr-namespace:Thistlecombe.AgentDesktop.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Brand.xaml" />
                <ResourceDictionary Source="Theme/Ledger.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <owm:StringToVisibilityConverter x:Key="StringToVisibility" />
            <owm:InverseBooleanConverter x:Key="InverseBool" />

            <DataTemplate DataType="{x:Type ow:LoginViewModel}">
                <views:AgentLoginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type ow:RegisterViewModel}">
                <views:AgentRegisterView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type ow:DocumentsViewModel}">
                <owv:DocumentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PoliciesViewModel}">
                <views:PoliciesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ClaimsViewModel}">
                <views:ClaimsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
