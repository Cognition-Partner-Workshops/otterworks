<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Colours and mark from frontend/client-app (lib/corporate.ts, assets/thistlecombe-mark.svg). -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1D5C54" />
    <SolidColorBrush x:Key="AccentBrushDark" Color="#164842" />
    <SolidColorBrush x:Key="GoldBrush" Color="#C08A2E" />
    <SolidColorBrush x:Key="GoldLightBrush" Color="#E9D3A6" />
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#F4F1EA" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />

    <!-- thistlecombe-mark.svg, viewBox 0 0 64 64 -->
    <DrawingImage x:Key="ThistlecombeMark">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H64 V64 H0 Z" />
                <GeometryDrawing Brush="#1D5C54"
                                 Geometry="M17 6h30a5 5 0 0 1 5 5v18c0 13-7 22-20 29-13-7-20-16-20-29V11a5 5 0 0 1 5-5Z" />
                <GeometryDrawing Geometry="M32 49V25M32 38c-4-7-10-8-14-6 2 6 7 9 14 9m0-9c4-7 10-8 14-6-2 6-7 9-14 9">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#C08A2E" Thickness="2.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#C08A2E">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="32,18" RadiusX="3.5" RadiusY="5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="Background" Value="#1D5C54" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#164842" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#8FB3AD" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="SecondaryButton">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="#D1D5DB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style TargetType="Button" x:Key="HeaderButton">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" BorderBrush="#7FA8A1" BorderThickness="1" CornerRadius="6" Padding="12,5"
                            Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#164842" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton" x:Key="NavTab">
        <Setter Property="Foreground" Value="#D7E6E3" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="tab" Padding="12,6" BorderThickness="0,0,0,3" BorderBrush="Transparent"
                            Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="tab" Property="BorderBrush" Value="#C08A2E" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
