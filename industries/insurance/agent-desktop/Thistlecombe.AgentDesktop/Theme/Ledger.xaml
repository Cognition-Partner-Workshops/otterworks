<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Pill for policy status (IN_FORCE, LAPSED) and claim triage outcome. -->
    <Style TargetType="Border" x:Key="StatusPill">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="#E7ECF3" />
        <Setter Property="TextElement.Foreground" Value="#334155" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="IN_FORCE">
                <Setter Property="Background" Value="#E1F0ED" />
                <Setter Property="TextElement.Foreground" Value="#1D5C54" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="FAST_TRACK">
                <Setter Property="Background" Value="#E1F0ED" />
                <Setter Property="TextElement.Foreground" Value="#1D5C54" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="LAPSED">
                <Setter Property="Background" Value="#ECECEC" />
                <Setter Property="TextElement.Foreground" Value="#4B5563" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="FRAUD_REVIEW">
                <Setter Property="Background" Value="#F6EBD7" />
                <Setter Property="TextElement.Foreground" Value="#7A5310" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="LARGE_LOSS">
                <Setter Property="Background" Value="#FBE5D2" />
                <Setter Property="TextElement.Foreground" Value="#9A3E0B" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="DECLINE_NOT_IN_FORCE">
                <Setter Property="Background" Value="#FBE3E1" />
                <Setter Property="TextElement.Foreground" Value="#B42318" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridColumnHeader" x:Key="LedgerHeader">
        <Setter Property="Background" Value="#F7F5EF" />
        <Setter Property="Foreground" Value="#374151" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="#E5E7EB" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style TargetType="DataGridColumnHeader" x:Key="MoneyHeader" BasedOn="{StaticResource LedgerHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style TargetType="DataGrid" x:Key="LedgerGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#EEF0F2" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="RowHeight" Value="32" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource LedgerHeader}" />
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E8F1EF" />
                            <Setter Property="Foreground" Value="#111827" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBlock" x:Key="MoneyCell">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="TextBlock" x:Key="CodeCell">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <DataTemplate x:Key="StatusCell">
        <Border Style="{StaticResource StatusPill}">
            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" />
        </Border>
    </DataTemplate>
</ResourceDictionary>
