<!doctype html>
<html><head><meta charset="utf-8"><title>Find a branch - Halvergate Bank</title>
<style>body{font-family:Arial,sans-serif;margin:2em;color:#1b2a3a}h1{color:#0b3d6b}li{margin:.4em 0}</style></head>
<body><h1>Find a branch</h1>
<form id="f"><input id="q" placeholder="Postcode or district" value="harbour"> <button>Search</button></form>
<ul id="out"></ul>
<script>
document.getElementById('f').onsubmit = function (e) {
  e.preventDefault();
  fetch('api/nearest?q=' + encodeURIComponent(document.getElementById('q').value))
    .then(function (r) { return r.json(); })
    .then(function (d) {
      document.getElementById('out').innerHTML = (d.branches || []).map(function (b) {
        return '<li><b>' + b.name + '</b>, ' + b.address + ' (' + b.km + ' km, ' + (b.open_now ? 'open now' : 'closed') + ')</li>';
      }).join('');
    });
};
</script></body></html>