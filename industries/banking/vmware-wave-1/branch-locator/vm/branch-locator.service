# /etc/systemd/system/branch-locator.service on web-02
[Unit]
Description=Branch locator
After=network.target

[Service]
User=branch-locator
Group=branch-locator
WorkingDirectory=/opt/branch-locator/app
ExecStart=/opt/branch-locator/venv/bin/python /opt/branch-locator/app/locator.py
Restart=always

[Install]
WantedBy=multi-user.target
