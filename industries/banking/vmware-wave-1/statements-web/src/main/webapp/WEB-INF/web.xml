<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
  <display-name>Customer statements</display-name>
  <listener>
    <listener-class>com.bank.statements.StatementsContext</listener-class>
  </listener>
  <servlet>
    <servlet-name>accounts</servlet-name>
    <servlet-class>com.bank.statements.AccountsServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>statement</servlet-name>
    <servlet-class>com.bank.statements.StatementServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>accounts</servlet-name>
    <url-pattern>/accounts</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>statement</servlet-name>
    <url-pattern>/statement</url-pattern>
  </servlet-mapping>
  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>
  <distributable/>
  <servlet>
    <servlet-name>health</servlet-name>
    <servlet-class>com.bank.statements.HealthServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>health</servlet-name>
    <url-pattern>/health</url-pattern>
  </servlet-mapping>
</web-app>
