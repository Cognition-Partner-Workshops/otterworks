//FLEBEN01 JOB (FLT,0410),'CAR BENEFIT RUN',CLASS=B,MSGCLASS=X,
//         NOTIFY=&SYSUID,REGION=0M
//*--------------------------------------------------------------------
//* MONTHLY COMPANY CAR BENEFIT RUN. SCHEDULED WD+3 AFTER PERIOD CLOSE.
//* SYSIN CARD: PERIOD YYYYMM
//*--------------------------------------------------------------------
//         SET PERIOD=202609
//*
//STEP010  EXEC PGM=FLEBEN01
//STEPLIB  DD DISP=SHR,DSN=FLT.PROD.LOADLIB
//         DD DISP=SHR,DSN=IDMS.PROD.LOADLIB
//SYSCTL   DD DISP=SHR,DSN=IDMS.PROD.SYSCTL
//SYSIDMS  DD *
DMCL=FLTDMCL
CVRETRY=ON
/*
//SYSIN    DD *,SYMBOLS=JCLONLY
&PERIOD
/*
//BENOUT   DD DSN=FLT.PROD.BENOUT.P&PERIOD,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,
//            SPACE=(TRK,(30,15),RLSE),
//            DCB=(RECFM=FB,LRECL=64,BLKSIZE=0)
//BENRPT   DD SYSOUT=*,DCB=(RECFM=FBA,LRECL=133)
//SYSOUT   DD SYSOUT=*
//*
//STEP020  EXEC PGM=ICETOOL,COND=(4,LT)
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//IN       DD DISP=SHR,DSN=FLT.PROD.BENOUT.P&PERIOD
//TOOLIN   DD *
  COUNT FROM(IN) WRITE(CNT) TEXT('BENOUT RECORDS ') DIGITS(6)
/*
//CNT      DD DSN=FLT.PROD.BENOUT.P&PERIOD..CNT,
//            DISP=(NEW,CATLG,DELETE),UNIT=SYSDA,SPACE=(TRK,1),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//*
//STEP030  EXEC PGM=FTP,PARM='(EXIT',COND=(4,LT)
//INPUT    DD DISP=SHR,DSN=FLT.PROD.FTP.PAYROLL
//OUTPUT   DD SYSOUT=*
