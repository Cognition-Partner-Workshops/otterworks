//FLEUNLD  JOB (FLT,0410),'FLEET FLAT UNLOAD',CLASS=B,MSGCLASS=X,
//         NOTIFY=&SYSUID,REGION=0M
//*--------------------------------------------------------------------
//* FLAT-FILE UNLOAD OF THE FLEET DATABASE. ONE FB FILE PER RECORD
//* TYPE, OWNER CALC KEY AND DB-KEY CARRIED ON EACH MEMBER RECORD.
//* LAYOUTS: FLEMPU FLVEHU FLASGU FLMCLU FLBPDU
//*--------------------------------------------------------------------
//STEP010  EXEC PGM=IDMSBCF,REGION=0M
//STEPLIB  DD DISP=SHR,DSN=IDMS.PROD.LOADLIB
//SYSCTL   DD DISP=SHR,DSN=IDMS.PROD.SYSCTL
//SYSIDMS  DD *
DMCL=FLTDMCL
/*
//EMPLOYEE DD DSN=FLT.UNLOAD.EMPLOYEE,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(15,5),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//VEHICLE  DD DSN=FLT.UNLOAD.VEHICLE,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//ASSIGN   DD DSN=FLT.UNLOAD.ASSIGNMENT,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=64,BLKSIZE=0)
//MILECLM  DD DSN=FLT.UNLOAD.MILECLM,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(30,15),RLSE),
//            DCB=(RECFM=FB,LRECL=64,BLKSIZE=0)
//BENPRD   DD DSN=FLT.UNLOAD.BENPRD,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,1),
//            DCB=(RECFM=FB,LRECL=40,BLKSIZE=0)
//SYSIPT   DD *
 CONNECT TO FLTDICT;
 UNLOAD SEGMENT FLTSEG01
   USING SUBSCHEMA FLEETSS2
   RECORD EMPLOYEE       TO EMPLOYEE  FORMAT FLEMPU  ORDER DBKEY
   RECORD VEHICLE        TO VEHICLE   FORMAT FLVEHU  ORDER CALC
     OWNER EMP-VEHICLE KEY AND DBKEY
   RECORD ASSIGNMENT     TO ASSIGN    FORMAT FLASGU  ORDER AREA
     OWNER EMP-ASSIGN KEY AND DBKEY
     OWNER VEH-ASSIGN KEY
   RECORD MILEAGE-CLAIM  TO MILECLM   FORMAT FLMCLU  ORDER AREA
     OWNER EMP-CLAIM KEY AND DBKEY
   RECORD BENEFIT-PERIOD TO BENPRD    FORMAT FLBPDU  ORDER CALC ;
/*
//SYSLST   DD SYSOUT=*
//*
//STEP020  EXEC PGM=ICETOOL,COND=(4,LT)
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//E        DD DISP=SHR,DSN=FLT.UNLOAD.EMPLOYEE
//V        DD DISP=SHR,DSN=FLT.UNLOAD.VEHICLE
//A        DD DISP=SHR,DSN=FLT.UNLOAD.ASSIGNMENT
//M        DD DISP=SHR,DSN=FLT.UNLOAD.MILECLM
//B        DD DISP=SHR,DSN=FLT.UNLOAD.BENPRD
//TOOLIN   DD *
  COUNT FROM(E) WRITE(CNT) TEXT('EMPLOYEE   ') DIGITS(6)
  COUNT FROM(V) WRITE(CNT) TEXT('VEHICLE    ') DIGITS(6)
  COUNT FROM(A) WRITE(CNT) TEXT('ASSIGNMENT ') DIGITS(6)
  COUNT FROM(M) WRITE(CNT) TEXT('MILECLM    ') DIGITS(6)
  COUNT FROM(B) WRITE(CNT) TEXT('BENPRD     ') DIGITS(6)
/*
//CNT      DD DSN=FLT.UNLOAD.CNT,DISP=(MOD,CATLG),UNIT=SYSDA,
//            SPACE=(TRK,1),DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
