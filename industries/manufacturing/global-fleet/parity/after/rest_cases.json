      "requests": [
        {
          "path": "/benefit/employees/E1009100/statement?period=202608",
          "status": 200,
          "expect": [
            {
              "path": "period",
              "equals": "202608"
            },
            {
              "path": "lines",
              "length": 0
            },
            {
              "path": "commuteDistance",
              "equals": 33
            },
            {
              "path": "ruleText",
              "contains_text": "1.00%"
            },
            {
              "path": "ruleText",
              "contains_text": "0.030%"
            }
          ]
        }
      ]
    },
    {
      "id": "statement-2026-09",
      "context": "statement",
      "jsf_fact": "E1009100 Priya Raman, 2026-09: no car lines, commute 33 km, rule 1.00 % list price + 0.030 % per km",
      "requests": [
        {
          "path": "/benefit/employees/E1009100/statement?period=202609",
          "status": 200,
          "expect": [
            {
              "path": "period",
              "equals": "202609"
            },
            {
              "path": "lines",
              "length": 0
            },
            {
              "path": "commuteDistance",
              "equals": 33
            },
            {
              "path": "ruleText",
              "contains_text": "1.00%"
            },
            {
              "path": "ruleText",
              "contains_text": "0.030%"
            }
          ]
        }
      ]
    },
    {
      "id": "statement-2026-10-new-car",
      "context": "statement",
      "jsf_fact": "2026-10 shows HH-VS 7629, 5 days, 105.55 EUR",
      "not_run": "depends on the state written by request-step-three-submit, which is not replayed"
    },
    {
      "id": "statement-unknown-employee",
      "context": "statement",
      "jsf_fact": "E9999999 is reported as not found",
      "requests": [
        {
          "path": "/benefit/employees/E9999999/statement?period=202610",
          "status": 404,
          "expect": [
            {
              "path": "code",
              "equals": "EMPLOYEE_NOT_FOUND"
            }
          ]
        }
      ]
    },
    {
      "id": "statement-no-parameters",
      "context": "statement",
      "jsf_fact": "the statement page without parameters renders the empty form",
      "not_run": "UI-only page state with no REST equivalent"
    },
    {
      "id": "statement-default-period",
      "context": "statement",
      "jsf_fact": "without a month the statement shows the previous month for E1009100, commute 33 km",
      "requests": [
        {
          "path": "/benefit/employees/E1009100/statement",
          "status": 200,
          "expect": [
            {
              "path": "period",
              "equals": "{previous_month}"
