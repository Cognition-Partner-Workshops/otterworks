    },
    {
      "id": "return-open",
      "context": "return",
      "jsf_fact": "the return page opens empty",
      "not_run": "UI-only page state with no REST equivalent"
    },
    {
      "id": "return-unknown-plate",
      "context": "return",
      "jsf_fact": "ZZ-UNKNOWN: no car with that plate",
      "requests": [
        {
          "path": "/returns/lookup?plate=ZZ-UNKNOWN",
          "status": 404,
          "expect": [
            {
              "path": "code",
              "equals": "VEHICLE_NOT_FOUND"
            }
          ]
        }
      ]
    },
    {
      "id": "return-unassigned-pool-car",
      "context": "return",
      "jsf_fact": "HH-VS 7629 is found assigned to E1009100 since the replay day",
      "not_run": "depends on the state written by request-step-three-submit, which is not replayed"
    },
    {
