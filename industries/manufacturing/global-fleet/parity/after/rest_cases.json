    {
      "id": "return-date-before-start",
      "context": "return",
      "jsf_fact": "a return dated before the handover is rejected",
      "not_run": "validation lives on the write endpoint (POST /returns); write case: not replayed, the after tenant is read-only for this harness"
    },
    {
      "id": "return-submit",
      "context": "return",
      "jsf_fact": "the return of K-XE 9032 is booked",
      "not_run": "write case: not replayed, the after tenant is read-only for this harness"
    },
    {
      "id": "health",
      "context": "static",
      "jsf_fact": "the service answers",
      "requests": [
        {
          "path": "/profile",
          "status": 200,
          "expect": [
            {
              "path": "sourceApp",
              "equals": "gf-jsf-portal"
            }
          ]
        }
      ]
    },
    {
      "id": "unmapped-404",
      "context": "static",
      "jsf_fact": "an unmapped path is a 404",
      "requests": [
        {
          "path": "/not-mapped",
          "status": 404,
          "expect": [
            {
              "path": "code",
              "equals": "NOT_FOUND"
            }
          ]
        }
      ]
    },
    {
      "id": "jsf-css-resource",
      "context": "static",
      "jsf_fact": "the portal stylesheet is served",
      "not_run": "JSF static resource; the React app ships its own assets"
    }
