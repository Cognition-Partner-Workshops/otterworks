# Defaults for the on-call storm harness. Every entry is a shell KEY=default
# that lib.sh exports only when the environment has not already set it, so
# `RUN_ID=oc02 make oncall-arm TENANT=oncall-before` overrides from the shell.
RUN_ID=oc01
BEFORE_TENANT=oncall-before
AFTER_TENANT=oncall-after
FIX_BRANCH=demo-oncall-after
TENANT_TTL=72h
SEED_DOCUMENTS=200000
SEED_FOLDERS=400
SEED_VERSIONS_PER_DOC=2
LOAD_VUS=6
LOAD_MINUTES=25
DIGEST_INTERVAL_SECONDS=15
DIGEST_CONCURRENCY=4
STATEMENT_TIMEOUT_MS=3000
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
P95_SLO_SECONDS=0.5
# Minutes the fixed tenant's page="oncall" alerts stay silenced while it is
# armed without load (arm.sh); load.sh expires the silence before k6 starts.
ARM_SILENCE_MINUTES=15
POSTGRES_CPU_LIMIT=1
CHANNEL_HOST=incident.demo.otterworks.app
DEMO_USER_EMAIL=oncall-demo@otterworks.example
