discovery.kubernetes "pods" {
	role = "pod"

	selectors {
		role  = "pod"
		field = "spec.nodeName=" + sys.env("NODE_NAME")
	}
}

discovery.relabel "oncall" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		regex         = "otterworks-oncall-.*|otterworks-platform"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app"]
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
		regex         = "(.+)"
		target_label  = "app"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}
}

loki.source.kubernetes "oncall" {
	targets    = discovery.relabel.oncall.output
	forward_to = [loki.write.oncall.receiver]
}

loki.write "oncall" {
	endpoint {
		url = "http://oncall-loki.monitoring.svc.cluster.local:3100/loki/api/v1/push"
	}
}
