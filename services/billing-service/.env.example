# Local procs stack (docker-compose.procs.yml sets these for the container).
BILLING_SVC_DATABASE_URL=postgresql://billing_svc:billing_svc@localhost:56445/billing_svc_dev
BILLING_SVC_ALLOW_INTERNAL_RESET=false

# RDS profile: the run database lp_<yyyymmdd>_<xx> on the private otterworks-postgres-dev.
# The instance only accepts connections from inside its VPC, so this URL is used by the
# <token>-billing-service function (infrastructure/terraform/billing-data), which builds it
# from the otterworks-<token>/billing-db secret; reach it with scripts/billing-service-proxy.py.
# Never put the password in a file.
# BILLING_SVC_DATABASE_URL=postgresql://lp_<yyyymmdd>_<xx>_billing:<from secret>@<instance endpoint>:5432/lp_<yyyymmdd>_<xx>?sslmode=verify-full&sslrootcert=rds-ca.pem
