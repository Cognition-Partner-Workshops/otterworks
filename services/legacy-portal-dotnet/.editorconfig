root = true

[*]
indent_style = space
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,json,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# Usings outside the file-scoped namespace, System first.
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:silent
csharp_style_var_when_type_is_apparent = true:silent

# StyleCop: house conventions for OtterWorks .NET services.
dotnet_diagnostic.SA1101.severity = none   # no this. prefix
dotnet_diagnostic.SA1200.severity = none   # usings outside namespace
dotnet_diagnostic.SA1309.severity = none   # _camelCase private fields
dotnet_diagnostic.SA1413.severity = none   # trailing commas optional
dotnet_diagnostic.SA1600.severity = none   # XML docs not required
dotnet_diagnostic.SA1601.severity = none
dotnet_diagnostic.SA1602.severity = none
dotnet_diagnostic.SA1633.severity = none   # no file headers
dotnet_diagnostic.SA1649.severity = none   # file may hold related types
dotnet_diagnostic.SA1402.severity = none   # request/response DTOs may share a file
dotnet_diagnostic.SA1516.severity = none
dotnet_diagnostic.SA1124.severity = none
dotnet_diagnostic.SA0001.severity = none   # XML doc analysis off (docs not required)
dotnet_diagnostic.SA1204.severity = none   # static helpers may follow overrides

# Analyzer noise not useful for this service.
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage delegates
dotnet_diagnostic.CA1716.severity = none   # namespace "Feedback" etc.
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait in ASP.NET app code

[Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none   # underscores in test names
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA2234.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.SA1118.severity = none
