      "inputs": {
        "p_actor": "alice",
        "p_agent_id": null,
        "p_effective_from": "2026-01-01",
        "p_product_code": "AUTO-STD",
        "p_rate_pct": "8.50"
      },
      "outputs": {
        "o_rate_id": 5.0
