      "sql": "BEGIN commission_pkg.upsert_commission_rate(:p_product_code, :p_agent_id, :p_rate_pct, :p_effective_from, :p_actor, :o_rate_id); END;",
      "writes": {
        "commission_rates": {
          "inserted": [
            {
              "agent_id": null,
              "created_by": "alice",
              "effective_from": "2026-01-01",
              "effective_to": null,
              "product_code": "AUTO-STD",
              "rate_id": 5,
              "rate_pct": "8.5"
            }
          ],
          "updated": [
            {
              "changes": {
                "effective_to": [
                  null,
                  "2025-12-31"
                ]
              },
              "rate_id": 1
            }
          ]
        },
        "rate_audit_log": {
          "inserted": [
