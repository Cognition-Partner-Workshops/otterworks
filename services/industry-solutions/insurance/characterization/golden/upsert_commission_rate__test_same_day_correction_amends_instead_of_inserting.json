              "audit_id": 1,
              "detail": "rate_id=5 pct=8.5 from=2026-01-01",
              "policy_id": null,
              "product_code": "AUTO-STD"
            }
          ]
        }
      }
    },
    {
      "call": "upsert_commission_rate",
      "inputs": {
        "p_actor": "bob",
        "p_agent_id": null,
        "p_effective_from": "2026-01-01",
        "p_product_code": "AUTO-STD",
        "p_rate_pct": "8.75"
      },
      "outputs": {
        "o_rate_id": 5.0
      },
      "sql": "BEGIN commission_pkg.upsert_commission_rate(:p_product_code, :p_agent_id, :p_rate_pct, :p_effective_from, :p_actor, :o_rate_id); END;",
      "writes": {
        "commission_rates": {
          "updated": [
            {
              "changes": {
                "created_by": [
                  "alice",
                  "bob"
                ],
                "rate_pct": [
                  "8.5",
                  "8.75"
                ]
              },
              "rate_id": 5
            }
          ]
        },
        "rate_audit_log": {
          "inserted": [
            {
              "action": "RATE_UPSERT",
              "actor": "bob",
              "agent_id": null,
              "audit_id": 2,
              "detail": "rate_id=5 pct=8.75 from=2026-01-01",
              "policy_id": null,
              "product_code": "AUTO-STD"
            }
          ]
        }
      }
    }
  ],
  "test": "tests/test_upsert_commission_rate.py::test_same_day_correction_amends_instead_of_inserting"
