  },
  "rules": {
    "unit": "one unit per legacy procedure module (services/legacy-billing/db/procs/<module>.sql): its routines, the collections it owns, the target module that replaces it. Every routine and every collection of mapping_spec v2 appears in exactly one unit.",
    "ownership": "a collection is owned (loaded, declared as write target) by the earliest wave that writes it or embeds its table; later units read it but never load it. A routine that writes another unit's collection does so through the owner's repository API (writes_via_owner), so each billing_migration.<collection> is a write target of exactly one batch and wave-preflight's collision check passes.",
    "depth": "0 = no other unit referenced; otherwise 1 + max depth of the units it reads from or writes through.",
    "wave": "PRD waves kept: 1 plans, 2 rating, 3 invoicing + dunning (two batches, d-wave-width 2). depth 2 and 3 share wave 3 because the dunning batch's write target (notifications) is disjoint from invoicing's and its recon compares notifications against its own source table; its parity scenarios read invoices from the reset-seeded fixture target."
  },
  "cross_unit_writes": [
    {
      "routine": "billing.sp_issue_invoice",
      "unit": "invoicing",
      "touches": "ratingPeriods",
      "owner": "rating",
      "resolution": "API through owner (finalize_rating)"
    },
    {
      "routine": "billing.sp_issue_invoice",
      "unit": "invoicing",
      "touches": "tenants.creditNotes",
      "owner": "plans",
      "resolution": "API through owner (apply_credit)"
    },
    {
      "routine": "billing.sp_schedule_dunning",
      "unit": "dunning",
      "touches": "invoices.dunningAttempts",
      "owner": "invoicing",
      "resolution": "API through owner (append_dunning_attempt); dunning_attempts rows loaded through the same API"
    },
    {
      "routine": "billing.sp_suspend_overdue",
      "unit": "dunning",
      "touches": "tenants, subscriptions",
      "owner": "plans",
      "resolution": "API through owner (suspend_tenant)"
    }
  ],
