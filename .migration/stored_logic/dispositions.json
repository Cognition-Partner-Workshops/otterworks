    {"object": "pkg_dunning.sp_suspend_overdue", "disposition": "converted", "target": "billing_logic.suspend_overdue"}
  ],
  "triggers": [
    {"object": "trg_sub_no_uncancel", "disposition": "reproduced",
     "target": "mongo_store.MongoStore.update_subscription",
     "effect": "a cancelled subscription can never leave the cancelled state",
     "reason": "the single writer of subscriptions.status_cd applies the rule for every caller"},
    {"object": "trg_subscriptions_hist", "disposition": "reproduced",
     "target": "mongo_store.MongoStore.update_subscription",
     "effect": "full-row version snapshot on update",
     "reason": "the snapshot is appended to the subscription's own history array"},
    {"object": "trg_usage_events_check", "disposition": "reproduced",
     "target": "load_unit.install_validator (usage_events $jsonSchema)",
     "effect": "rejects units <= 0 and a kind_cd outside the CODES domain",
     "reason": "enforced by the collection validator, so it rejects the write rather than the caller checking"},
    {"object": "trg_customer_master_hist", "disposition": "reproduced",
     "target": "customers.history (migrated by the customers unit)",
     "effect": "snapshot of the previous row into CUSTOMER_MASTER_HIST on update",
     "reason": "the snapshots live in the customer's own history array; no converted routine writes the customer master, so there is no writer left to fire on"},
    {"object": "trg_billing_audit_log_id", "disposition": "retired",
     "target": "mongo_store.MongoStore.log",
     "effect": "assigned LOG_ID from SEQ_BILLING_AUDIT_LOG",
     "reason": "surrogate id retired with its sequence; an audit entry is identified by its own _id"},
    {"object": "trg_customer_master_seq", "disposition": "retired",
     "target": "customers._id (CUST_ID)",
     "effect": "assigned CUST_SEQ_NO from SEQ_CUSTOMER_MASTER",
     "reason": "natural key adopted at STOP B decision 4; nothing reads the surrogate"},
    {"object": "trg_entity_attr_value_seq", "disposition": "retired",
     "target": "customers.attributes[]",
     "effect": "assigned EAV row ids from SEQ_ENTITY_ATTR_VALUE",
     "reason": "the attribute rows became array elements inside their customer, so they need no id of their own"}
  ],
  "jobs": [
    {"object": "JOB_NIGHTLY_DUNNING", "disposition": "rehomed",
     "replacement": "billing_logic.nightly_dunning",
     "note": "same two calls in the same order, invoked by the application scheduler instead of DBMS_SCHEDULER"},
    {"object": "JOB_PURGE_AUDIT_LOG", "disposition": "rehomed",
     "replacement": "TTL index on billing_audit_log.logged_at (mongo_store.MongoStore.ensure_indexes)",
     "note": "the job's hardcoded 90-day DELETE becomes expireAfterSeconds=7776000"}
  ],
  "sequences": [
    {"object": "seq_billing_audit_log", "disposition": "retired", "natural_key": "billing_audit_log._id"},
    {"object": "seq_customer_master", "disposition": "retired", "natural_key": "customers._id (CUST_ID)"},
    {"object": "seq_customer_master_hist", "disposition": "retired", "natural_key": "customers.history[] (containment)"},
    {"object": "seq_entity_attr_value", "disposition": "retired", "natural_key": "customers.attributes[] (containment)"},
    {"object": "seq_subscriptions_hist", "disposition": "retired", "natural_key": "subscriptions.history[].hist_id (position within its subscription)"}
  ]
